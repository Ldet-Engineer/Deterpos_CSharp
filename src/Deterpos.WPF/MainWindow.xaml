                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark" FontSize="24" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Seguridad de Información Empresarial" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock x:Name="TxtLastBackupStatus" Text="Recomendación: Genere un respaldo al final de cada jornada o antes de cierres mensuales." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <!-- Botón Crear Respaldo -->
                                                <Button Click="BtnCreateBackup_Click" Background="{StaticResource AccentGreenBrush}" Foreground="White" BorderThickness="0"
                                                        Padding="18,10" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,12,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <fluentIcons:SymbolIcon Symbol="ArrowDownload" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Generar Respaldo Ahora (.sql)" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Botón Restaurar Respaldo -->
                                                <Button Click="BtnRestoreBackup_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                        Padding="18,10" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <fluentIcons:SymbolIcon Symbol="ArrowUpload" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Restaurar Copia de Seguridad..." VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Fluent:BackstageTabItem>

                        <!-- PESTAÑA 6: INTEGRACIÓN CASHEA BNPL (OPCIONAL) -->
                        <Fluent:BackstageTabItem x:Name="TabBackstageCashea" Header="Integración Cashea BNPL">
                            <ScrollViewer Margin="30,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                    <!-- Encabezado con Icono -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#E0F2FE" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <fluentIcons:SymbolIcon Symbol="BarcodeScanner" FontSize="26" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Integración Comercial Cashea BNPL (Opcional)" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Active o desactive el método de pago quincenal sin intereses, configure comisiones y código de comercio aliado." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tarjeta 1: Activación y Modo de Operación -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Estado del Módulo y Modo Operativo" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                                            <TextBlock Text="Cashea permite a sus clientes pagar una inicial en caja y financiar el saldo en 3 cuotas quincenales garantizadas por la plataforma." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                                            <!-- Switch Activación -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Habilitar Cashea BNPL en Deterpos" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="Al activar, se mostrará la pestaña en el Ribbon y el botón '[F10] Cobrar con Cashea' en el Punto de Venta." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkCasheaEnabled" Grid.Column="1" Content="Activar" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Parámetros del Comercio -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Código Comercio Aliado:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtCasheaMerchantCode" Grid.Column="1" Text="CSH-MKT-001" Padding="10,6" Width="320" HorizontalAlignment="Left" ToolTip="Código asignado por Cashea a su establecimiento" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nombre del Comercio Aliado:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtCasheaMerchantName" Grid.Column="1" Text="Deterpos C.A." Padding="10,6" Width="320" HorizontalAlignment="Left" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Identificador QR en Mostrador:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtCasheaQrCode" Grid.Column="1" Text="CASHEA-MESA-01" Padding="10,6" Width="320" HorizontalAlignment="Left" ToolTip="Etiqueta o código impreso en el acrílico de caja" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Comisión Comercial Acordada (%):" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtCasheaCommission" Grid.Column="1" Text="5.0" Padding="10,6" Width="120" HorizontalAlignment="Left" ToolTip="Porcentaje pactado de deducción comercial (habitual: 5% a 7%)" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Plazo Estimado de Liquidación (Días):" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtCasheaSettlementDays" Grid.Column="1" Text="5" Padding="10,6" Width="120" HorizontalAlignment="Left" ToolTip="Días promedio en que Cashea transfiere al banco del comercio" />
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Monto Mínimo Financiable ($ USD):" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtCasheaMinAmount" Grid.Column="1" Text="15.00" Padding="10,6" Width="120" HorizontalAlignment="Left" />
                                            </Grid>

                                            <!-- Tarjeta 2: Simulador Rápido de Cuotas Cashea -->
                                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <fluentIcons:SymbolIcon Symbol="Calculator" FontSize="18" Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Simulador de Cuotas Cashea en Tiempo Real" FontWeight="Bold" FontSize="13.5" Foreground="#0369A1" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="Comprueba al instante cómo se distribuye una venta financiada para tus clientes según tus parámetros comerciales." FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Monto Venta ($):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                            <TextBox x:Name="TxtCasheaSimAmount" Text="60.00" Padding="8,5" TextChanged="TxtCasheaSimAmount_TextChanged" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                            <TextBlock Text="Inicial en Caja (40%):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="TxtCasheaSimInitial" Text="$ 24.00" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,5,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                                            <TextBlock Text="3 Cuotas Quincenales:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="TxtCasheaSimInstallments" Text="3 x $ 12.00" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnSaveCasheaSettings" Click="BtnSaveCasheaSettings_Click" Content="Guardar Configuración Cashea" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" 
                                                        Padding="18,9" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock x:Name="TxtCasheaSettingsStatus" Text="" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Fluent:BackstageTabItem>

                        <!-- PESTAÑA 7: ACERCA DE DETERPOS ERP -->
