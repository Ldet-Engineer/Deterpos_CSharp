                                                <TextBox x:Name="TxtDbUser" Grid.Column="1" Text="postgres" Padding="10,6" Width="320" HorizontalAlignment="Left" />
                                            </Grid>

                                            <Grid Margin="0,0,0,18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Contraseña:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <PasswordBox x:Name="TxtDbPassword" Grid.Column="1" Password="postgres" Padding="10,6" Width="320" HorizontalAlignment="Left" />
                                            </Grid>

                                            <!-- Botones Probar y Guardar -->
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnTestDbConnection" Click="BtnTestDbConnection_Click" Content="Probar Conexión PostgreSQL" Style="{StaticResource ModernPrimaryActionButtonStyle}" BorderThickness="1" 
                                                        Padding="16,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,12,0">
