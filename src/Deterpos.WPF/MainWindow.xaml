        </Fluent:Ribbon>

        <!-- ============================================== -->
        <!--  ÁREA DE TRABAJO PRINCIPAL (CONMUTADOR DE VISTAS) -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">

            <!-- VISTA 1: DASHBOARD GENERAL -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsDashboardViewActive, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="30,24" MaxWidth="1350" HorizontalAlignment="Stretch">

                    <!-- Encabezado del Módulo Activo -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ActiveViewTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Operación comercial, auditoría fiscal SENIAT, flujos de caja y balance multimoneda" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Botones de Acción Rápida -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding RefreshDashboardCommand}" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    Padding="12,10" Margin="0,0,10,0" Cursor="Hand" ToolTip="Actualizar Indicadores">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <fluentIcons:SymbolIcon Symbol="ArrowSync" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Refrescar" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenCalculatorCommand}" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <fluentIcons:SymbolIcon Symbol="Calculator" FontSize="18" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Calculadora" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Punto de Venta (POS)"
                                    Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                                    Padding="20,10" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <fluentIcons:SymbolIcon Symbol="Cart" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Abrir Terminal POS (F1)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tarjetas KPI Principales Multimoneda y Fiscales -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tarjeta 1: Ventas en Dólares (Base) -->
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="VENTAS DEL DÍA (USD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <fluentIcons:SymbolIcon Symbol="Money" FontSize="20" HorizontalAlignment="Right" Foreground="{StaticResource AccentGreenBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding TodaySalesUSD, StringFormat={}{0:C2}}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,2" />
                                <TextBlock Text="Moneda Base ($)" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 2: Ventas en Bolívares (VES Legal) -->
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="MONTO FISCAL LEGAL (VES)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <fluentIcons:SymbolIcon Symbol="Receipt" FontSize="20" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrandBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding TodaySalesVES, StringFormat=Bs. {0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,2" />
                                <TextBlock Text="Tasa BCV del Día (Obligatoria)" FontSize="12" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 3: Tasa de Cambio Activa -->
                        <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="TASA OFICIAL BCV" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <fluentIcons:SymbolIcon Symbol="ArrowTrendingLines" FontSize="20" HorizontalAlignment="Right" Foreground="{StaticResource AccentGoldBrush}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                    <TextBlock Text="1 USD = " FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding BcvRate, StringFormat={}{0:N4} Bs.}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Banco Central de Venezuela" FontSize="12" Foreground="{StaticResource AccentGoldBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta 4: Estado Fiscal de la Caja -->
                        <Border Grid.Column="6" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ESTADO FISCAL SENIAT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <fluentIcons:SymbolIcon Symbol="ShieldCheckmark" FontSize="20" HorizontalAlignment="Right" Foreground="{StaticResource AccentGreenBrush}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                    <TextBlock Text="Z-Report: #" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding LastZReport}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Impresora Fiscal En Línea" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 2: Indicadores Secundarios de Flujo y Cartera (4 Píldoras Ejecutivas) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Píldora 1: Comprobantes Hoy -->
                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#EFF6FF" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <fluentIcons:SymbolIcon Symbol="Receipt" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="COMPROBANTES HOY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TodayInvoicesCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" facturas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,1" />
                                        <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,2,1" />
                                        <TextBlock Text="{Binding TodayCreditNotesCount}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                        <TextBlock Text=" N/C" FontSize="11" Foreground="#DC2626" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Píldora 2: CxC Cartera Activa -->
                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#ECFDF5" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <fluentIcons:SymbolIcon Symbol="PersonMoney" FontSize="18" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CUENTAS POR COBRAR (CxC)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TotalReceivableUSD, StringFormat={}${0:N2}}" FontSize="16" FontWeight="Bold" Foreground="#059669" />
                                        <TextBlock Text="{Binding TotalReceivableVES, StringFormat= (Bs. {0:N0})}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Píldora 3: CxP Compromisos Proveedores -->
                        <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FEF2F2" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <fluentIcons:SymbolIcon Symbol="Payment" FontSize="18" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CUENTAS POR PAGAR (CxP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TotalPayableUSD, StringFormat={}${0:N2}}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" />
                                        <TextBlock Text="{Binding TotalPayableVES, StringFormat= (Bs. {0:N0})}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Píldora 4: Gastos del Mes -->
                        <Border Grid.Column="6" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FFFBEB" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                    <fluentIcons:SymbolIcon Symbol="ShoppingBag" FontSize="18" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GASTOS DEL MES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding MonthExpensesUSD, StringFormat={}${0:N2}}" FontSize="16" FontWeight="Bold" Foreground="#D97706" />
                                        <TextBlock Text="{Binding MonthExpensesVES, StringFormat= (Bs. {0:N0})}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Fila 3: Tendencia Semanal de Ventas y Multimoneda / Fiscal -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tarjeta Gráfico de Ventas Semanal -->
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Tendencia Semanal de Facturación" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Ventas diarias en Moneda Base USD durante los últimos 7 días" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="Últimos 7 Días" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                                    </Border>
                                </Grid>

                                <!-- Barras de Gráfico Semanal -->
                                <ItemsControl ItemsSource="{Binding DashboardWeeklySales}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,0" VerticalAlignment="Bottom">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="130" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- Monto USD -->
                                                <TextBlock Grid.Row="0" Text="{Binding TotalUSD, StringFormat={}${0:N0}}" FontSize="10" FontWeight="Bold" Foreground="#0067B8" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <!-- Track y Barra -->
                                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Width="32" ClipToBounds="True">
                                                    <ProgressBar Orientation="Vertical" Value="{Binding HeightPercentage}" Minimum="0" Maximum="100" Width="32" Background="Transparent" BorderThickness="0">
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Grid>
                                                                    <Border Name="PART_Track" Background="Transparent" />
                                                                    <Border Name="PART_Indicator" Background="#0067B8" CornerRadius="4" VerticalAlignment="Bottom" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                </Border>
                                                <!-- Día de la semana -->
                                                <TextBlock Grid.Row="2" Text="{Binding DayName}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <!-- Fecha corta -->
                                                <TextBlock Grid.Row="3" Text="{Binding Date, StringFormat={}{0:dd/MM}}" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!-- Tarjeta Lateral: Multimoneda y Resumen Fiscal -->
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Divisas y Estado Fiscal" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Button Command="{Binding OpenUpdateRateCommand}" HorizontalAlignment="Right" Background="Transparent" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <fluentIcons:SymbolIcon Symbol="Edit" FontSize="12" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Tasas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel>
                                    <!-- Items de Divisas -->
                                    <ItemsControl ItemsSource="{Binding Currencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Code}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding RateToUSD, StringFormat={}{0:N4}}" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pill Perfil Fiscal SENIAT -->
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SENIAT Providencia 0141 / DTD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                            <TextBlock Text="Sujeto Pasivo Especial • IGTF 3% Divisas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FiscalPrinterBrand}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 4: Alertas de Inventario Crítico y Últimos Comprobantes -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tabla 1: Alertas de Stock Bajo -->
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Alertas de Stock Mínimo" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Background="#FEE2E2" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} Críticos}" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                                        </Border>
                                    </StackPanel>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Inventario y Catálogo" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="Ver Catálogo →" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                    </Button>
                                </Grid>

                                <DataGrid ItemsSource="{Binding DashboardLowStock}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeight="36"
                                          MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="90" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="ACTUAL" Binding="{Binding CurrentStock, StringFormat={}{0:N0}}" Width="65" />
                                        <DataGridTextColumn Header="MÍNIMO" Binding="{Binding MinimumStock, StringFormat={}{0:N0}}" Width="65" />
                                        <DataGridTemplateColumn Header="ESTADO" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UrgencyLevel}" Value="Agotado">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UrgencyLevel}" Value="Crítico">
                                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding UrgencyLevel}" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UrgencyLevel}" Value="Agotado">
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding UrgencyLevel}" Value="Crítico">
                                                                            <Setter Property="Foreground" Value="#D97706" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Tabla 2: Últimos Comprobantes Emitidos en Vivo -->
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Comprobantes Recientes" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Background="#DCFCE7" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="En Vivo" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                        </Border>
                                    </StackPanel>
                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Documentos Fiscales" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="Ver Todos →" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                    </Button>
                                </Grid>

                                <DataGrid ItemsSource="{Binding DashboardRecentSales}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeight="36"
                                          MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding InvoiceNumber}" Width="110" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerName}" Width="*" />
                                        <DataGridTextColumn Header="HORA" Binding="{Binding CreatedAt, StringFormat={}{0:hh:mm tt}}" Width="70" />
                                        <DataGridTextColumn Header="TOTAL ($)" Binding="{Binding TotalUSD, StringFormat={}${0:N2}}" Width="80" FontWeight="SemiBold" Foreground="#059669" />
                                        <DataGridTemplateColumn Header="TIPO" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCreditNote}" Value="True">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCreditNote}" Value="False">
                                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCreditNote}" Value="True">
                                                                            <Setter Property="Text" Value="N/C" />
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCreditNote}" Value="False">
                                                                            <Setter Property="Text" Value="Factura" />
                                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- VISTA 2: GESTIÓN MULTIMONEDA Y TASAS DE CAMBIO (FASE 1) -->
            <views:CurrencyManagementView Visibility="{Binding IsCurrencyViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 3: GESTIÓN DE INVENTARIO Y CATÁLOGO (FASE 2) -->
            <views:InventoryCatalogView x:Name="ViewInventoryCatalog" Visibility="{Binding IsInventoryViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 4: DIRECTORIO DE CLIENTES Y PROVEEDORES (FASE 3) -->
            <views:CustomersSuppliersView x:Name="ViewCustomersSuppliers" Visibility="{Binding IsCustomersViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 5: CONTROL DE CAJA, TURNOS Y ARQUEO CIEGO (FASE 4) -->
            <views:CashControlView x:Name="ViewCashControl" Visibility="{Binding IsCashViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 6: TERMINAL PUNTO DE VENTA POS F1 (FASE 5) -->
            <views:PosView x:Name="ViewPos" Visibility="{Binding IsPosViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 7: DOCUMENTOS FISCALES Y NOTAS DE CRÉDITO SENIAT (FASE 6) -->
            <views:SalesInvoicesView x:Name="ViewSalesInvoices" Visibility="{Binding IsSalesInvoicesViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 8: COMPRAS, RECEPCIÓN Y COSTEO PROMEDIO USD (FASE 7) -->
            <views:PurchasesView x:Name="ViewPurchases" Visibility="{Binding IsPurchasesViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 9: CUENTAS POR COBRAR (CxC) Y CUENTAS POR PAGAR (CxP) (FASE 8) -->
            <views:CreditManagementView x:Name="ViewCreditManagement" Visibility="{Binding IsCreditViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 10: GASTOS OPERATIVOS Y CAJA CHICA (FASE 9) -->
            <views:OperatingExpensesView x:Name="ViewOperatingExpenses" Visibility="{Binding IsExpensesViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 11: LIBROS OFICIALES SENIAT Y REPORTES EJECUTIVOS (FASE 10) -->
            <views:FiscalReportsView x:Name="ViewFiscalReports" Visibility="{Binding IsFiscalReportsViewActive, Converter={StaticResource BoolToVisConverter}}" />

            <!-- VISTA 12: GESTIÓN DE CASHEA BNPL (COMPRA AHORA, PAGA DESPUÉS) -->
            <views:CasheaBnplView x:Name="ViewCasheaBnpl" Visibility="{Binding IsCasheaViewActive, Converter={StaticResource BoolToVisConverter}}" />

        </Grid>

        <!-- ============================================== -->
        <!--  BARRA DE ESTADO INFERIOR (STATUS BAR OFFICE)  -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="#0078D4" Height="28" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" Fill="#6CCB5F" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DbStatusText}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" ToolTip="Tasa oficial del Banco Central de Venezuela">
                    <fluentIcons:SymbolIcon Symbol="ArrowSync" FontSize="11" Foreground="#A6D5FA" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock Text="Tasa BCV: 1 $ = " Foreground="#D0E7FB" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BcvRate, StringFormat={}{0:N4} Bs.}" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border Background="#107C41" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BcvSyncStatusText}" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Caja: " Foreground="#D0E7FB" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CashRegisterStatus}" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="Fiscal: Impresora En Línea (Z101)" Foreground="#D0E7FB" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0" />
                    <TextBlock Text="Usuario: " Foreground="#D0E7FB" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="#005A9E" CornerRadius="4" Margin="0,0,15,0" VerticalAlignment="Center">
                        <Button Click="BtnLogout_Click" Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,2" Cursor="Hand" ToolTip="Cerrar sesión actual o relevar cajero">
                            <StackPanel Orientation="Horizontal">
                                <fluentIcons:SymbolIcon Symbol="SignOut" FontSize="10" Foreground="#FED7AA" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Salir / Relevo" FontSize="9.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <TextBlock Text="Moneda Base: USD ($)" Foreground="#FFF5C2" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Fluent:RibbonWindow>
