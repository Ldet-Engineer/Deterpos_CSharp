<Fluent:RibbonWindow x:Class="Deterpos.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Fluent="urn:fluent-ribbon"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:vm="clr-namespace:Deterpos.WPF.ViewModels"
        xmlns:views="clr-namespace:Deterpos.WPF.Views"
        Title="Deterpos ERP - [Sucursal Principal]" 
        Icon="pack://application:,,,/Resources/favicon.ico"
        Height="820" Width="1300"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Fluent:RibbonWindow.DataContext>
        <vm:MainViewModel />
    </Fluent:RibbonWindow.DataContext>

    <Grid Background="{StaticResource SurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!--  RIBBON PRINCIPAL ESTILO MICROSOFT OFFICE  -->
        <!-- ========================================== -->
        <Fluent:Ribbon Grid.Row="0">

            <!-- Barra de Acceso Rápido (QAT) -->
            <Fluent:Ribbon.QuickAccessItems>
                <Fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnQatPos}" />
                <Fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnQatTasa}" />
                <Fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnQatArqueo}" />
                <Fluent:QuickAccessMenuItem Target="{Binding ElementName=BtnQatReporteZ}" />
            </Fluent:Ribbon.QuickAccessItems>

            <!-- Menú de la Aplicación: CONFIGURACIÓN Y GESTIÓN (Backstage) -->
            <Fluent:Ribbon.Menu>
                <Fluent:Backstage x:Name="RibbonBackstage" Header="Configuración" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}">
                    <Fluent:BackstageTabControl x:Name="BackstageTabs">

                        <!-- PESTAÑA 1: INFORMACIÓN Y PERFIL DE EMPRESA -->
                        <Fluent:BackstageTabItem x:Name="TabBackstageCompany" Header="Información de Empresa">
                            <ScrollViewer Margin="30,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                    <!-- Encabezado con Icono -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#EFF6FC" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <fluentIcons:SymbolIcon Symbol="Building" FontSize="26" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Perfil y Datos de la Empresa" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Identificación jurídica, domicilio tributario y sucursal de operaciones activa" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tarjeta 1: Identificación Legal y RIF con Botón de Edición -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Identificación Legal y Tributaria (Venezuela)" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Click="BtnEditCompanyProfile_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0" Padding="14,7" Cursor="Hand" FontWeight="SemiBold">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <fluentIcons:SymbolIcon Symbol="Edit" FontSize="15" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Editar Perfil de Empresa" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Razón Social:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyBusinessName" Grid.Row="0" Grid.Column="1" Text="Deterpos C.A." FontWeight="Bold" Margin="0,6" FontSize="13.5" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Registro Fiscal (RIF):" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyRif" Grid.Row="1" Grid.Column="1" Text="J-40918273-0 (Contribuyente Especial)" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,6" FontSize="13.5" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Nombre Comercial:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyTradeName" Grid.Row="2" Grid.Column="1" Text="Deterpos ERP - Punto de Venta y Distribución" Margin="0,6" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Domicilio Fiscal:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyAddress" Grid.Row="3" Grid.Column="1" Text="Av. Francisco de Miranda, Edif. Torre Centro, Nivel PB, Caracas, D.C." Margin="0,6" TextWrapping="Wrap" />

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Teléfonos de Contacto:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyPhone" Grid.Row="4" Grid.Column="1" Text="+58 (212) 555-0199 / +58 (414) 234-5678" Margin="0,6" />

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Correo Electrónico:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyEmail" Grid.Row="5" Grid.Column="1" Text="administracion@deterpos.com.ve" Margin="0,6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta 2: Parámetros del Sistema y Monedas -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Parámetros de Operación Comercial" FontWeight="Bold" FontSize="15" Margin="0,0,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sucursal Activa:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyBranch" Grid.Row="0" Grid.Column="1" Text="{Binding CurrentBranch}" FontWeight="SemiBold" Margin="0,6" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Terminal / Punto:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TxtCompanyTerminal" Grid.Row="1" Grid.Column="1" Text="Caja Principal Mostrador 01" Margin="0,6" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Moneda Base Inmutable:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Dólar ($ USD) • Valoración Contable por Costo Promedio Ponderado (CPP)" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,6" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Moneda Legal Local:" FontWeight="SemiBold" Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Bolívar Digital (Bs. VES) según Tasa Oficial del Banco Central de Venezuela (BCV)" Margin="0,6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta 3: Estado de la Licencia -->
                                    <Border Background="#F9FAFB" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark" FontSize="26" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Licencia Comercial Activa • Deterpos Enterprise Edition v2.0" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Arquitectura .NET 10 WPF homologada para operaciones fiscales en Venezuela." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="ACTIVO • HOMOLOGADO" FontWeight="Bold" FontSize="10.5" Foreground="#166534" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Fluent:BackstageTabItem>

                        <!-- PESTAÑA 2: USUARIOS, ROLES Y SEGURIDAD (Módulo Completo Trasladado) -->
                        <Fluent:BackstageTabItem x:Name="TabBackstageUsers" Header="Usuarios y Seguridad">
                            <views:UsersManagementView x:Name="BackstageUsersView" />
                        </Fluent:BackstageTabItem>

                        <!-- PESTAÑA 3: CUMPLIMIENTO FISCAL SENIAT -->
                        <Fluent:BackstageTabItem x:Name="TabBackstageSeniat" Header="Cumplimiento Fiscal SENIAT">
                            <ScrollViewer Margin="30,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                    <!-- Encabezado con Icono -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <fluentIcons:SymbolIcon Symbol="DocumentCheckmark" FontSize="26" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Normativa Tributaria y Homologación SENIAT" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Parámetros de facturación fiscal, percepción de IGTF y control de impresoras homologadas." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tarjeta: Condición de Contribuyente e IGTF -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Condición del Sujeto Pasivo Especial (SENIAT)" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />
                                            <CheckBox x:Name="ChkSpecialTaxpayerSeniat" Content="Empresa designada como Sujeto Pasivo Especial (Contribuyente Especial SENIAT)"
                                                      IsChecked="{Binding IsSpecialTaxpayer}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock Text="• Aplica automáticamente la percepción de la alícuota del 3% de IGTF sobre pagos recibidos en divisas extranjeras (USD, EUR, Zelle, efectivo) según Providencia SNAT/2022/000013."
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,12" TextWrapping="Wrap" />

                                            <Grid Margin="20,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Alícuota de IGTF:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                                                    <TextBlock Text="3.00 % (Alícuota Legal Fija según Providencia SNAT/2022/000013)" FontWeight="Bold" Foreground="#B45309" FontSize="12.5" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta: Dispositivo de Emisión Fiscal -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="Dispositivo de Facturación Fiscal (Providencia 0141)" FontWeight="Bold" FontSize="15" Margin="0,0,0,12" />

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Marca de Impresora Fiscal:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <ComboBox x:Name="CmbFiscalPrinterBrand" Grid.Column="1" SelectedIndex="0" Padding="8,6" Width="360" HorizontalAlignment="Left">
                                                    <ComboBoxItem Content="The Factory HKA (Bixolon SRP-350 / HKA-80)" />
                                                    <ComboBoxItem Content="Dascom Tally (DT-230)" />
                                                    <ComboBoxItem Content="Bematech (MP-4000 TH FI)" />
                                                    <ComboBoxItem Content="Custom (Kube II)" />
                                                    <ComboBoxItem Content="Forma Libre Computarizada (N° de Control SENIAT)" />
                                                    <ComboBoxItem Content="Facturación Electrónica Digital" />
                                                </ComboBox>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Puerto de Comunicación:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtFiscalPort" Grid.Column="1" Text="{Binding FiscalPort}" Padding="8,6" Width="260" HorizontalAlignment="Left" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Serial de Máquina Fiscal:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtFiscalSerial" Grid.Column="1" Text="{Binding FiscalSerial}" Padding="8,6" Width="260" HorizontalAlignment="Left" Background="#F9F9F9" FontWeight="Bold" />
                                            </Grid>

                                            <Border Background="#E6F4EA" BorderBrush="#34A853" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,14">
                                                <StackPanel Orientation="Horizontal">
                                                    <fluentIcons:SymbolIcon Symbol="CheckmarkCircle" FontSize="18" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtFiscalDeviceStatusText" Text="{Binding FiscalDeviceStatus}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnSaveFiscalConfig" Click="BtnSaveFiscalConfig_Click" Content="Guardar Parámetros Fiscales" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button x:Name="BtnTestFiscalDevice" Click="BtnTestFiscalDevice_Click" Content="Probar Comunicación Fiscal" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,8" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Fluent:BackstageTabItem>

                        <!-- PESTAÑA 4: CONFIGURACIÓN MULTIMONEDA -->
                        <Fluent:BackstageTabItem x:Name="TabBackstageCurrency" Header="Configuración Multimoneda">
                            <ScrollViewer Margin="30,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                    <!-- Encabezado con Icono -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <fluentIcons:SymbolIcon Symbol="CurrencyDollarEuro" FontSize="26" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Gestión Multimoneda y Tipos de Cambio" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="El Dólar ($) es la moneda base inmutable y el Bolívar (Bs.) es la moneda primaria local según tasa oficial BCV. Puedes activar o desactivar Euros y Pesos." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                        <ItemsControl ItemsSource="{Binding Currencies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrandBrush}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                                <TextBlock Text="{Binding Code}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="Paridad a 1 USD:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding RateToUSD, StringFormat={}{0:N4}}" FontWeight="Bold" FontSize="14" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                <TextBlock Text="Tipo de Moneda:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                                    <Setter Property="Text" Value="Principal (Fija)" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrandBrush}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsFixed}" Value="False">
                                                                                    <Setter Property="Text" Value="Opcional" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <CheckBox Grid.Column="4" Content="Habilitada en Sistema" 
                                                                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                      FontWeight="SemiBold" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Fluent:BackstageTabItem>

                        <!-- PESTAÑA 5: BASE DE DATOS POSTGRESQL Y RESPALDOS -->
                        <Fluent:BackstageTabItem x:Name="TabBackstageDb" Header="Base de Datos PostgreSQL">
                            <ScrollViewer Margin="30,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                                    <!-- Encabezado con Icono -->
                                    <Grid Margin="0,0,0,22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#DBEAFE" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <fluentIcons:SymbolIcon Symbol="Database" FontSize="26" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Infraestructura, Conexión y Respaldos PostgreSQL" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Configuración del motor de datos, prueba de conectividad y copias de seguridad nativas (.sql / .backup)." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tarjeta 1: Parámetros del Servidor y Credenciales -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Parámetros del Servidor y Conectividad" FontWeight="Bold" FontSize="15" Margin="0,0,0,6" />
                                            <TextBlock Text="Compatible con instalaciones de PostgreSQL nativo en Windows para clientes y entornos de desarrollo Docker." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" />

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Host / Dirección IP:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtDbHost" Grid.Column="1" Text="localhost" Padding="10,6" Width="320" HorizontalAlignment="Left" ToolTip="Usa 'localhost' para máquina única o la IP local (ej. 192.168.1.50) si el servidor está en red" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Puerto TCP:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBox x:Name="TxtDbPort" Grid.Column="1" Text="5432" Padding="10,6" Width="140" HorizontalAlignment="Left" />
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nombre Base de Datos:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
