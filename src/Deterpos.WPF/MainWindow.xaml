                                            <TextBlock Text="Proteja toda la información fiscal, movimientos de kárdex y transacciones comerciales generando un archivo de respaldo periódico (.sql)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
