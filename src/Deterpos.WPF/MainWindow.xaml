                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <Button x:Name="BtnSaveDbConfig" Click="BtnSaveDbConfig_Click" Content="Guardar Parámetros de Conexión" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                        Padding="16,8" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock x:Name="TxtDbConnectionStatusMessage" Text="" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta 2: Respaldos y Restauración de Base de Datos -->
                                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
