<UserControl x:Class="Deterpos.WPF.Controls.DialogContextBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             x:Name="Root">

    <Border Background="#F8FAFC" 
            Padding="20,10" 
            BorderBrush="#E2E8F0" 
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True" VerticalAlignment="Center">
            <!-- Contenido Adicional opcional a la derecha (Badges, tags, status) -->
            <ContentPresenter DockPanel.Dock="Right" 
                              Content="{Binding ExtraContent, ElementName=Root}" 
                              VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fluentIcons:SymbolIcon 
                    Symbol="{Binding Symbol, ElementName=Root}" 
                    FontSize="18" 
                    Foreground="{Binding IconBrush, ElementName=Root, TargetNullValue={StaticResource PrimaryBrandBrush}}" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center" />

                <TextBlock 
                    Text="{Binding Text, ElementName=Root}" 
                    FontSize="12" 
                    FontWeight="Medium"
                    Foreground="{StaticResource TextSecondaryBrush}" 
                    VerticalAlignment="Center" 
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
