<UserControl x:Class="Deterpos.WPF.Views.OperatingExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!--  FILA 0: ENCABEZADO Y TARJETAS MÉTRICAS DE GASTOS -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título y Subtítulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Gastos Operativos y Salidas de Caja Chica" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                    <Border Background="#FDE7E9" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="CONTROL DE EGRESOS" FontSize="11" FontWeight="Bold" Foreground="#D83B01" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Registro y control de gastos administrativos, servicios, nómina, compras menores y descargos de caja chica." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Métricas Resumen -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Tarjeta 1: Total Gastos (Mes Actual) -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="TOTAL GASTOS (MES)" FontSize="10" FontWeight="Bold" Foreground="#D83B01" />
                        <TextBlock x:Name="TxtMetricsTotalUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="#D83B01" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsTotalVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Salidas de Caja Chica -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="SALIDAS CAJA CHICA" FontSize="10" FontWeight="Bold" Foreground="#E38B29" />
                        <TextBlock x:Name="TxtMetricsCashBoxUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="#E38B29" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsCashBoxVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Pagos Bancarios / Transferencias -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="PAGOS BANCARIOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                        <TextBlock x:Name="TxtMetricsBankUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsBankVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ============================================== -->
        <!--  FILA 1: BARRA DE ACCIÓN Y FILTROS            -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Botón Registrar Gasto -->
                <Button Grid.Column="0" Click="BtnNewExpense_Click" Background="#D83B01" Foreground="White" BorderThickness="0"
                        Padding="16,8" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <fluentIcons:SymbolIcon Symbol="Add" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Registrar Gasto / Salida" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Filtro de Origen: Todos / Caja Chica / Bancos -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbFilterAll" Content="Todos" GroupName="ExpenseOriginFilter" IsChecked="True" Checked="FilterOrigin_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="0,0,4,0" Cursor="Hand" />
                    <RadioButton x:Name="RbFilterCashBox" Content="Caja Chica" GroupName="ExpenseOriginFilter" Checked="FilterOrigin_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="0,0,4,0" Cursor="Hand" />
                    <RadioButton x:Name="RbFilterBank" Content="Bancos / Zelle" GroupName="ExpenseOriginFilter" Checked="FilterOrigin_Checked"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Cursor="Hand" />
                </StackPanel>

                <!-- Filtro por Categoría -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Categoría:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbCategoryFilter" Width="180" Height="32" SelectionChanged="CmbCategoryFilter_SelectionChanged" DisplayMemberPath="Name" />
                </StackPanel>

                <!-- Buscador por texto -->
                <Grid Grid.Column="6">
                    <TextBox x:Name="TxtSearch" Padding="28,6,8,6" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center" Height="32">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <fluentIcons:SymbolIcon Symbol="Search" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="Buscar beneficiario, concepto..." FontSize="12" Foreground="#999999"
                               VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Botón Refrescar -->
                <Button Grid.Column="8" Click="BtnRefresh_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Padding="10,6" Height="32" Cursor="Hand" ToolTip="Actualizar Lista">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <fluentIcons:SymbolIcon Symbol="ArrowSync" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refrescar" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!--  FILA 2: TABLA DE GASTOS OPERATIVOS           -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
            <DataGrid x:Name="GridExpenses" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="0" Background="Transparent" HeadersVisibility="Column"
                      RowHeight="42" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <!-- Fecha y Hora -->
                    <DataGridTextColumn Header="FECHA" Binding="{Binding ExpenseDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="125" FontWeight="SemiBold" />

                    <!-- Categoría con Badge -->
                    <DataGridTemplateColumn Header="CATEGORÍA" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#EFF6FC" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category.Name}" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Beneficiario -->
                    <DataGridTextColumn Header="BENEFICIARIO / PROVEEDOR" Binding="{Binding Beneficiary}" Width="1.2*" FontWeight="SemiBold" />

                    <!-- Descripción / Justificación -->
                    <DataGridTextColumn Header="CONCEPTO / DESCRIPCIÓN" Binding="{Binding Description}" Width="2*" />

                    <!-- N° de Comprobante / Factura -->
                    <DataGridTextColumn Header="N° COMPROBANTE" Binding="{Binding ReceiptNumber}" Width="120" />

                    <!-- Origen del Pago -->
                    <DataGridTemplateColumn Header="ORIGEN DEL FONDO" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F3F2F1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentOrigin}" Value="CajaChica">
                                                    <Setter Property="Background" Value="#FFF4CE" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentOrigin}" Value="BancoTransferencia">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentOrigin}" Value="PagoMovil">
                                                    <Setter Property="Background" Value="#E6F4EA" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentOrigin}" Value="ZelleUSD">
                                                    <Setter Property="Background" Value="#E1DFDD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PaymentOrigin}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#323130" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentOrigin}" Value="CajaChica">
                                                        <Setter Property="Foreground" Value="#8E562E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentOrigin}" Value="BancoTransferencia">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentOrigin}" Value="PagoMovil">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Monto Original -->
                    <DataGridTemplateColumn Header="MONTO ORIG." Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrencyCode}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding AmountOriginal, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Monto en USD Base -->
                    <DataGridTextColumn Header="MONTO ($)" Binding="{Binding AmountUSD, StringFormat={}{0:C2}}" Width="100" FontWeight="Bold" Foreground="#D83B01" />

                    <!-- Monto en VES -->
                    <DataGridTextColumn Header="EQUIV. BS." Binding="{Binding AmountVES, StringFormat={}{0:N2} Bs.}" Width="120" Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Autorizado Por -->
                    <DataGridTextColumn Header="AUTORIZADO" Binding="{Binding AuthorizedBy}" Width="110" />

                    <!-- Acciones -->
                    <DataGridTemplateColumn Header="ACCIÓN" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="BtnCancelExpense_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Anular este gasto" Padding="4">
                                    <fluentIcons:SymbolIcon Symbol="DismissSquare" FontSize="16" Foreground="#D83B01" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>

