<UserControl x:Class="Deterpos.WPF.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!--  FILA 0: ENCABEZADO Y TARJETAS MÉTRICAS DE COMPRA -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título y Subtítulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Compras y Recepción de Mercancía" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                    <Border Background="#E6F4EA" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="COSTEO PROMEDIO PONDERADO USD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Abastecimiento de almacén, recepción física de mercancía, crédito fiscal SENIAT y Cuentas por Pagar (CxP)." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Métricas Resumen -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Tarjeta 1: Total Compras -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="TOTAL COMPRAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtMetricsTotalUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsTotalVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Facturas Recibidas -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="140">
                    <StackPanel>
                        <TextBlock Text="FACTURAS RECIBIDAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtMetricsCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="Documentos procesados" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Compras a Crédito (CxP) -->
                <Border Background="#FFF8F0" BorderBrush="#FED9B7" BorderThickness="1" CornerRadius="8" Padding="16,10" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="COMPRAS A CRÉDITO (CxP)" FontSize="10" FontWeight="Bold" Foreground="#D83B01" />
                        <TextBlock x:Name="TxtMetricsCreditUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="#D83B01" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsCreditVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ============================================== -->
        <!--  FILA 1: BARRA DE FILTROS Y ACCIONES           -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Buscador por texto -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="TxtSearch" Padding="28,6,8,6" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <fluentIcons:SymbolIcon Symbol="Search" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="Buscar N° Factura, Control, Proveedor..." FontSize="12" Foreground="#999999"
                               VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Filtro Condición de Pago -->
                <ComboBox Grid.Column="2" x:Name="CmbCondition" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="Todas las Condiciones" />
                    <ComboBoxItem Content="Solo Contado" />
                    <ComboBoxItem Content="Solo Crédito (CxP)" />
                </ComboBox>

                <!-- Filtros de Fecha Rápidos -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbDateToday" Content="Hoy" GroupName="PurchaseDateFilters" Checked="DateFilter_Checked" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbDateWeek" Content="7 Días" GroupName="PurchaseDateFilters" Checked="DateFilter_Checked" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="RbDateMonth" Content="Este Mes" GroupName="PurchaseDateFilters" IsChecked="True" Checked="DateFilter_Checked" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <RadioButton x:Name="RbDateAll" Content="Histórico" GroupName="PurchaseDateFilters" Checked="DateFilter_Checked" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Botones de Acción a la derecha -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnRefresh_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="10,6" Margin="0,0,8,0" Cursor="Hand" ToolTip="Actualizar Historial">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <fluentIcons:SymbolIcon Symbol="ArrowSync" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <Button Click="BtnNewPurchase_Click" Background="{StaticResource AccentGreenBrush}" Foreground="White" BorderThickness="0"
                            Padding="14,6" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="AddSquare" FontSize="15" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Registrar Compra" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!--  FILA 2: GRILLA DE FACTURAS DE COMPRA          -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
            <DataGrid x:Name="DgPurchases" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                      BorderThickness="0" Background="White" RowHeight="42" SelectionMode="Single"
                      MouseDoubleClick="DgPurchases_MouseDoubleClick">
                <DataGrid.Columns>

                    <!-- Fecha Recepción -->
                    <DataGridTemplateColumn Header="FECHA RECEPCIÓN" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ReceivedDateDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Proveedor -->
                    <DataGridTemplateColumn Header="PROVEEDOR EMISOR" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding SupplierName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SupplierRif}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- N° Factura Proveedor -->
                    <DataGridTemplateColumn Header="N° FACTURA" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource PrimaryBrandBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- N° Control SENIAT -->
                    <DataGridTemplateColumn Header="N° CONTROL" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ControlNumber}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Condición (Badge) -->
                    <DataGridTemplateColumn Header="CONDICIÓN" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ConditionBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConditionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{Binding ConditionForeground}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Subtotal USD -->
                    <DataGridTemplateColumn Header="SUBTOTAL ($)" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SubtotalDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Crédito Fiscal IVA USD -->
                    <DataGridTemplateColumn Header="IVA CRÉD. ($)" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaxDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Total USD -->
                    <DataGridTemplateColumn Header="TOTAL ($)" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalUSDDisplay}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Total Bolívares -->
                    <DataGridTemplateColumn Header="TOTAL (Bs.)" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalVESDisplay}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones -->
                    <DataGridTemplateColumn Header="ACCIONES" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="BtnViewDetails_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" ToolTip="Ver Detalle de Compra">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <fluentIcons:SymbolIcon Symbol="Eye" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Ver" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>

