<UserControl x:Class="Deterpos.WPF.Views.CreditManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!--  FILA 0: ENCABEZADO Y TARJETAS MÉTRICAS DE CRÉDITO -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título y Subtítulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Cuentas por Cobrar (CxC) y por Pagar (CxP)" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                    <Border Background="#E6F4EA" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="CRÉDITOS PROTEGIDOS EN USD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Gestión de cartera deudora bimonetaria, liquidación a tasa oficial BCV y conciliación de abonos." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Métricas Resumen -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Tarjeta 1: Cartera por Cobrar (CxC) -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="CARTERA POR COBRAR (CxC)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                        <TextBlock x:Name="TxtMetricsCxcUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsCxcVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Cartera por Pagar (CxP) -->
                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="DEUDA A PROVEEDORES (CxP)" FontSize="10" FontWeight="Bold" Foreground="#D83B01" />
                        <TextBlock x:Name="TxtMetricsCxpUSD" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="#D83B01" Margin="0,2,0,0" />
                        <TextBlock x:Name="TxtMetricsCxpVES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- ============================================== -->
        <!--  FILA 1: SELECTOR DE PESTAÑAS Y BUSCADOR       -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Segment Tabs Modernos -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton x:Name="RbTabCxc" Content="Cuentas por Cobrar (Clientes)" GroupName="CreditTabGroup" IsChecked="True" Checked="CreditTab_Checked"
                                 Style="{StaticResource SegmentedTabRadioStyle}" Margin="0,0,8,0" />
                    <RadioButton x:Name="RbTabCxp" Content="Cuentas por Pagar (Proveedores)" GroupName="CreditTabGroup" Checked="CreditTab_Checked"
                                 Style="{StaticResource SegmentedTabRadioStyle}" Margin="0,0,8,0" />
                    <RadioButton x:Name="RbTabCustomerHistory" Content="Historial de Abonos" GroupName="CreditTabGroup" Checked="CreditTab_Checked"
                                 Style="{StaticResource SegmentedTabRadioStyle}" Margin="0,0,8,0" />
                    <RadioButton x:Name="RbTabSupplierHistory" Content="Historial Pagos Proveedor" GroupName="CreditTabGroup" Checked="CreditTab_Checked"
                                 Style="{StaticResource SegmentedTabRadioStyle}" />
                </StackPanel>

                <!-- Buscador por texto -->
                <Grid Grid.Column="2">
                    <TextBox x:Name="TxtSearch" Padding="28,6,8,6" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <fluentIcons:SymbolIcon Symbol="Search" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" 
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="Buscar por nombre o documento..." FontSize="12" Foreground="#999999"
                               VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Botón Actualizar -->
                <Button Grid.Column="4" Click="BtnRefresh_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Padding="10,6" Cursor="Hand" ToolTip="Actualizar Cartera">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <fluentIcons:SymbolIcon Symbol="ArrowSync" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!--  FILA 2: CONTENIDO DE LAS GRILLAS              -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
            <Grid>

                <!-- 1. Grilla Cuentas por Cobrar (Clientes con deuda) -->
                <DataGrid x:Name="DgCustomersDebt" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                          BorderThickness="0" Background="White" RowHeight="42" SelectionMode="Single"
                          Visibility="Visible">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÉDULA / RIF" Binding="{Binding DocumentNumber}" Width="120" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="NOMBRE DEL CLIENTE" Binding="{Binding FullName}" Width="2*" />
                        <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Phone}" Width="130" />
                        <DataGridTextColumn Header="LÍMITE CRÉDITO ($)" Binding="{Binding CreditLimitUSD, StringFormat={}${0:N2}}" Width="130" />

                        <!-- Saldo Deudor USD -->
                        <DataGridTemplateColumn Header="DEUDA ($)" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentBalanceUSD, StringFormat={}${0:N2}}" FontWeight="Bold" Foreground="#D83B01" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Saldo Deudor VES -->
                        <DataGridTemplateColumn Header="DEUDA (Bs.)" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentBalanceVESDisplay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Click="BtnAbonarCliente_Click" Background="#E6F4EA" BorderBrush="#34A853" BorderThickness="1"
                                                Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <fluentIcons:SymbolIcon Symbol="MoneyHand" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Abonar" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Click="BtnEstadoCuentaCliente_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                Padding="8,4" Cursor="Hand" ToolTip="Ver Estado de Cuenta">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                            <fluentIcons:SymbolIcon Symbol="DocumentBulletList" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 2. Grilla Cuentas por Pagar (Proveedores con deuda) -->
                <DataGrid x:Name="DgSuppliersDebt" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                          BorderThickness="0" Background="White" RowHeight="42" SelectionMode="Single"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RIF" Binding="{Binding DocumentNumber}" Width="120" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="RAZÓN SOCIAL PROVEEDOR" Binding="{Binding CompanyName}" Width="2*" />
                        <DataGridTextColumn Header="CONTACTO" Binding="{Binding ContactName}" Width="140" />
                        <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Phone}" Width="130" />

                        <!-- Deuda Pendiente USD -->
                        <DataGridTemplateColumn Header="DEUDA ($)" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentDebtUSD, StringFormat={}${0:N2}}" FontWeight="Bold" Foreground="#D83B01" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Deuda Pendiente VES -->
                        <DataGridTemplateColumn Header="DEUDA (Bs.)" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentDebtVESDisplay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Click="BtnPagarProveedor_Click" Background="#FFF8F0" BorderBrush="#FED9B7" BorderThickness="1"
                                                Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <fluentIcons:SymbolIcon Symbol="Payment" FontSize="12" Foreground="#8E562E" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Pagar" FontSize="11" FontWeight="Bold" Foreground="#8E562E" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Click="BtnEstadoCuentaProveedor_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                Padding="8,4" Cursor="Hand" ToolTip="Ver Estado de Cuenta">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                            <fluentIcons:SymbolIcon Symbol="DocumentBulletList" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 3. Grilla Historial Abonos Clientes -->
                <DataGrid x:Name="DgCustomerPaymentsHistory" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                          BorderThickness="0" Background="White" RowHeight="38" SelectionMode="Single"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding PaymentDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="125" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer.FullName}" Width="2*" />
                        <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding Id, StringFormat={}AB-{0:D6}}" Width="110" FontWeight="Bold" />
                        <DataGridTextColumn Header="MÉTODO" Binding="{Binding PaymentMethod}" Width="130" />
                        <DataGridTextColumn Header="MONEDA" Binding="{Binding CurrencyCode}" Width="75" />
                        <DataGridTextColumn Header="MONTO PAGADO" Binding="{Binding AmountOriginal, StringFormat={}{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="AMORTIZADO ($)" Binding="{Binding AmountUSD, StringFormat={}${0:N2}}" Width="110" FontWeight="Bold" />
                        <DataGridTextColumn Header="SALDO RESULTANTE ($)" Binding="{Binding RemainingBalanceUSD, StringFormat={}${0:N2}}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 4. Grilla Historial Pagos Proveedores -->
                <DataGrid x:Name="DgSupplierPaymentsHistory" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                          BorderThickness="0" Background="White" RowHeight="38" SelectionMode="Single"
                          Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding PaymentDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="125" />
                        <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Supplier.CompanyName}" Width="2*" />
                        <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding Id, StringFormat={}PAG-{0:D6}}" Width="110" FontWeight="Bold" />
                        <DataGridTextColumn Header="MÉTODO" Binding="{Binding PaymentMethod}" Width="130" />
                        <DataGridTextColumn Header="MONEDA" Binding="{Binding CurrencyCode}" Width="75" />
                        <DataGridTextColumn Header="MONTO PAGADO" Binding="{Binding AmountOriginal, StringFormat={}{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="AMORTIZADO ($)" Binding="{Binding AmountUSD, StringFormat={}${0:N2}}" Width="110" FontWeight="Bold" />
                        <DataGridTextColumn Header="DEUDA RESULTANTE ($)" Binding="{Binding RemainingDebtUSD, StringFormat={}${0:N2}}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </Grid>
</UserControl>

