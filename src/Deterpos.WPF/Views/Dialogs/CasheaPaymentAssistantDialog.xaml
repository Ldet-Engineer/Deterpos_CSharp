<Window x:Class="Deterpos.WPF.Views.Dialogs.CasheaPaymentAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Cobro y Financiamiento Cashea BNPL"
        Width="780" Height="730"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna y Borde Redondeado -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal Arrastrable -->
            <Border Grid.Row="0" Background="#F0F9FF" CornerRadius="12,12,0,0" Padding="22,14" BorderBrush="#BAE6FD" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0284C7" CornerRadius="8" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Payment" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Asistente de Cobro Cashea BNPL" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="SIN INTERESES" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Calcula la inicial en caja, el plan de 3 cuotas quincenales y emite la factura legal al 100%." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Contenido Principal -->
            <ScrollViewer Grid.Row="1" Margin="22,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Tarjeta Resumen de Venta -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL FACTURA EN DÓLARES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtTotalSaleUSD" Text="$ 0.00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="14,0" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MONTO FISCAL EN BOLÍVARES (BCV)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock x:Name="TxtTotalSaleVES" Text="0.00 Bs." FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtExchangeRateDisplay" Text="Tasa BCV: 55.40 Bs." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fila: Datos del Cliente y Nivel Cashea -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <!-- Cédula -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cédula de Identidad *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCustomerDoc" Padding="8,6" Text="V-" FontWeight="Bold" />
                        </StackPanel>

                        <!-- Nombre -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nombre del Cliente *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCustomerName" Padding="8,6" Text="Cliente Mostrador" />
                        </StackPanel>

                        <!-- Nivel Cashea -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Nivel Cashea del Cliente *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbCasheaLevel" SelectedIndex="2" SelectionChanged="CmbCasheaLevel_SelectionChanged">
                                <ComboBoxItem Content="Nivel 1 (Inicial 60%)" Tag="1" />
                                <ComboBoxItem Content="Nivel 2 (Inicial 50%)" Tag="2" />
                                <ComboBoxItem Content="Nivel 3 (Inicial 40%) - Habitual" Tag="3" />
                                <ComboBoxItem Content="Nivel 4 (Inicial 30%)" Tag="4" />
                                <ComboBoxItem Content="Nivel 5 (Inicial 20%)" Tag="5" />
                                <ComboBoxItem Content="Personalizado..." Tag="0" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Tarjetas de Inicial vs Saldo Financiado -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tarjeta Inicial (A cobrar en caja) -->
                        <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1.5" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="INICIAL A COBRAR EN CAJA" FontSize="11" FontWeight="Bold" Foreground="#047857" />
                                    <Border Background="#A7F3D0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtDownPaymentPct" Text="40%" FontSize="10" FontWeight="Bold" Foreground="#065F46" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtDownPaymentUSD" Text="$ 0.00" FontSize="22" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtDownPaymentVES" Text="0.00 Bs." FontSize="12" FontWeight="SemiBold" Foreground="#047857" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta Saldo Financiado (Cashea asume) -->
                        <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="SALDO FINANCIADO POR CASHEA" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
                                    <Border Background="#BFDBFE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="3 Cuotas" FontSize="10" FontWeight="Bold" Foreground="#1E40AF" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtFinancedAmountUSD" Text="$ 0.00" FontSize="22" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtFinancedAmountVES" Text="0.00 Bs." FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cronograma Informativo de Cuotas Quincenales -->
                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fluentIcons:SymbolIcon Symbol="Clock" FontSize="16" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cronograma de Pago de Cuotas para el Cliente (Cada 14 Días)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="El cliente pagará estas cuotas directamente en su app" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Cuota 1 -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CUOTA 1 (14 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtDateQuota1" Text="14 días" FontSize="10.5" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="SemiBold" Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtAmountQuota1USD" Text="$ 0.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtAmountQuota1VES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Cuota 2 -->
                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CUOTA 2 (28 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtDateQuota2" Text="28 días" FontSize="10.5" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="SemiBold" Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtAmountQuota2USD" Text="$ 0.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtAmountQuota2VES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Cuota 3 -->
                                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CUOTA 3 (42 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtDateQuota3" Text="42 días" FontSize="10.5" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="SemiBold" Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtAmountQuota3USD" Text="$ 0.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtAmountQuota3VES" Text="0.00 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Sección: Cobro de la Inicial en Caja y Código de Orden -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Registro de Cobro en Mostrador y Orden Cashea" FontWeight="Bold" FontSize="12.5" Foreground="#92400E" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Método de Pago de la Inicial -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Medio de Pago Inicial *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbDownPaymentMethod" SelectedIndex="0">
                                        <ComboBoxItem Content="Punto de Débito (Bs.)" Tag="PuntoDeVenta" />
                                        <ComboBoxItem Content="Pago Móvil (Bs.)" Tag="PagoMovil" />
                                        <ComboBoxItem Content="Efectivo USD ($)" Tag="EfectivoUSD" />
                                        <ComboBoxItem Content="Efectivo Bolívares" Tag="EfectivoVES" />
                                        <ComboBoxItem Content="Transferencia Bancaria" Tag="TransferenciaBancaria" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- N° Referencia Inicial -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ref. Pago Inicial (Opcional)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtDownPaymentRef" Padding="8,6" ToolTip="Últimos dígitos de la tarjeta o referencia bancaria" />
                                </StackPanel>

                                <!-- N° de Orden Cashea / Aprobación -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="N° de Orden Cashea *" FontSize="11" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtCasheaOrderNum" Padding="8,6" FontWeight="Bold" FontSize="13" Foreground="#B45309" ToolTip="Código mostrado en la app del cliente (ej. CSH-84215)" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Barra de Acciones Inferior -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Emisión Fiscal SENIAT: Factura emitida por el 100% de la venta." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,8" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" FontSize="12.5" />
                        </Button>

                        <Button x:Name="BtnConfirmCasheaSale" Click="BtnConfirmCasheaSale_Click" Background="{StaticResource AccentGreenBrush}" Foreground="White" BorderThickness="0" Padding="20,8" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <fluentIcons:SymbolIcon Symbol="Checkmark" FontSize="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Confirmar y Facturar Venta Fiscal" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
