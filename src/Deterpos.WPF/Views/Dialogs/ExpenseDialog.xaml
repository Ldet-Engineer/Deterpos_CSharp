<Window x:Class="Deterpos.WPF.Views.Dialogs.ExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Registrar Gasto Operativo" 
        Height="650" Width="520"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="20,14" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Receipt" FontSize="26" Foreground="#D83B01" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registrar Gasto Operativo / Salida" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Control de Costos Operativos y Salidas de Caja Chica" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Formulario de Gasto -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>

                    <!-- Categoría del Gasto -->
                    <TextBlock Text="Categoría del Gasto:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CmbCategories" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,5" />
                        <Button Grid.Column="2" Click="BtnNewCategory_Click" Content="+ Nueva" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,4" FontWeight="SemiBold" Cursor="Hand" ToolTip="Crear nueva categoría" />
                    </Grid>

                    <!-- Beneficiario -->
                    <TextBlock Text="Beneficiario / Proveedor de Servicio:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtBeneficiary" Padding="8,5" Margin="0,0,0,10" />

                    <!-- Descripción / Justificación -->
                    <TextBlock Text="Concepto / Justificación del Gasto:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtDescription" Height="45" TextWrapping="Wrap" Padding="8,5" Margin="0,0,0,10" />

                    <!-- N° de Recibo o Factura -->
                    <TextBlock Text="N° de Recibo / Factura / Comprobante:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtReceiptNumber" Padding="8,5" Margin="0,0,0,10" />

                    <!-- Origen del Dinero -->
                    <TextBlock Text="Origen del Dinero (Método de Pago):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbOrigin" SelectedIndex="0" SelectionChanged="CmbOrigin_SelectionChanged" Padding="8,5" Margin="0,0,0,10">
                        <ComboBoxItem Content="Caja Chica (Efectivo de Turno)" />
                        <ComboBoxItem Content="Banco / Transferencia Bancaria" />
                        <ComboBoxItem Content="Pago Móvil Bancario" />
                        <ComboBoxItem Content="Zelle USD" />
                        <ComboBoxItem Content="Otro Origen" />
                    </ComboBox>

                    <!-- Moneda del Gasto y Tasa Oficial -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Moneda del Gasto:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbCurrency" SelectedIndex="0" SelectionChanged="CmbCurrency_SelectionChanged" Padding="8,5">
                                <ComboBoxItem Content="Dólares USD ($)" />
                                <ComboBoxItem Content="Bolívares VES (Bs.)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tasa Oficial BCV:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtBcvRate" IsReadOnly="True" Background="#F0F0F0" Padding="8,5" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <!-- Monto del Gasto -->
                    <TextBlock Text="Monto del Gasto:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAmountInput" Text="0.00" Padding="10,6" FontSize="14" FontWeight="Bold" TextChanged="TxtAmountInput_TextChanged" Margin="0,0,0,8" />

                    <!-- Equivalencia en USD si pagó en Bs -->
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Equivalente en Moneda Base USD:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtEquivalentUSD" Text="$ 0.00 USD" FontWeight="Bold" FontSize="13" Foreground="#D83B01" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Checkbox Caja Chica -->
                    <CheckBox x:Name="ChkDeductFromCash" Content="Egresar efectivo de Caja Actual (Turno Abierto)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <!-- Notas adicionales -->
                    <TextBlock Text="Notas Adicionales:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtNotes" Height="36" TextWrapping="Wrap" Padding="6,4" />

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="13" />
                    </Button>

                    <Button Grid.Column="3" Click="BtnSubmitExpense_Click" Background="#D83B01" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Registrar Gasto" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

