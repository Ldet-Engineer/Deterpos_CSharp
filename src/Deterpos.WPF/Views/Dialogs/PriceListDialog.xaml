<Window x:Class="Deterpos.WPF.Views.Dialogs.PriceListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Lista Oficial de Precios Multimoneda - Deterpos" 
        Height="620" Width="890"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar x:Name="ContextBar" Grid.Row="0" 
                               Symbol="Money" 
                               IconBrush="#107C41" 
                               Text="Precios bimonetarios actualizados con Tasa Oficial BCV" />

            <!-- Barra de Búsqueda y Filtros -->
            <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Buscador -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fluentIcons:SymbolIcon Symbol="Search" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                     FontSize="12" TextChanged="TxtSearch_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Filtro por Categoría -->
                    <ComboBox x:Name="CmbCategoryFilter" Grid.Column="2" Height="32" SelectionChanged="CmbCategoryFilter_SelectionChanged" />

                    <!-- Contador de Artículos -->
                    <TextBlock x:Name="TxtCountInfo" Grid.Column="4" Text="Cargando productos..." FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Grilla Principal de Precios -->
            <Border Grid.Row="2" Padding="20,14">
                <DataGrid x:Name="DgPriceList" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F2F5"
                          BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" Background="White" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Code}" Width="95" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="CÓD. BARRAS" Binding="{Binding Barcode}" Width="115" />
                        <DataGridTextColumn Header="DESCRIPCIÓN DEL ARTÍCULO" Binding="{Binding Name}" Width="*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding CategoryName}" Width="110" />
                        <DataGridTextColumn Header="COSTO ($)" Binding="{Binding CostUSD, StringFormat={}${0:N2}}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PVP USD ($)" Binding="{Binding PriceUSD, StringFormat={}${0:N2}}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="#107C41" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PVP LEGAL BCV (Bs.)" Binding="{Binding PriceVES, StringFormat={}{0:N2} Bs.}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrandBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="MARGEN" Binding="{Binding MarginPercent, StringFormat={}{0:N1}%}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="3" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="BtnExportCsv_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="14,7" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="ArrowDownload" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Exportar Lista (Excel / CSV)" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                            Padding="22,7" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Aceptar y Salir" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
</Window>