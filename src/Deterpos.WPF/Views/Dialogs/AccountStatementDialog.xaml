<Window x:Class="Deterpos.WPF.Views.Dialogs.AccountStatementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Estado de Cuenta Histórico - Deterpos" 
        Height="630" Width="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar x:Name="ContextBar" Grid.Row="0" 
                               Symbol="DocumentBulletList" 
                               Text="Auditoría cronológica de cargos, abonos y saldo remanente" />

            <!-- Contenido Principal -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>

                    <!-- Tarjeta Titular y Resumen de Saldos -->
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TITULAR DE LA CUENTA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtAccountHolderName" Text="Carlos Mendoza" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtAccountHolderDoc" Text="V-18456789" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOTAL CARGOS (+)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtTotalDebits" Text="$ 0.00" FontWeight="Bold" FontSize="14" Foreground="#D83B01" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOTAL ABONOS (-)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtTotalCredits" Text="$ 0.00" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGreenBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="SALDO PENDIENTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock x:Name="TxtCurrentBalance" Text="$ 0.00" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock x:Name="TxtCurrentBalanceVES" Text="0.00 Bs." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Grilla de Movimientos Cronológicos -->
                    <TextBlock Text="Movimientos Cronológicos del Crédito:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,12">
                        <DataGrid x:Name="DgMovements" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                                  BorderThickness="0" Background="White" RowHeight="36" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="125" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding DocumentType}" Width="120" />
                                <DataGridTextColumn Header="COMPROBANTE" Binding="{Binding DocumentNumber}" Width="110" />
                                <DataGridTextColumn Header="CONCEPTO / DETALLE" Binding="{Binding Concept}" Width="2*" />
                                <DataGridTextColumn Header="CARGO ($)" Binding="{Binding DebitUSD, StringFormat={}${0:N2}}" Width="90" />
                                <DataGridTextColumn Header="ABONO ($)" Binding="{Binding CreditUSD, StringFormat={}${0:N2}}" Width="90" />
                                <DataGridTextColumn Header="SALDO ($)" Binding="{Binding RunningBalanceUSD, StringFormat={}${0:N2}}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        <!-- Barra Inferior -->
        <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Click="BtnPrint_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        Padding="16,7" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <fluentIcons:SymbolIcon Symbol="Print" FontSize="14" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Imprimir Estado de Cuenta" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Click="BtnClose_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                        Padding="22,7" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Cerrar" FontSize="13" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

