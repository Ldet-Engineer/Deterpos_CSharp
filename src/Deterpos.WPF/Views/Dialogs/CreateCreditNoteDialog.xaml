<Window x:Class="Deterpos.WPF.Views.Dialogs.CreateCreditNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Nota de Crédito Fiscal SENIAT" 
        Height="700" Width="760"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="22,14" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="ArrowUndo" FontSize="26" Foreground="#D83B01" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Generar Nota de Crédito Fiscal SENIAT" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Providencia SNAT/2011/00071 • Reversión Fiscal y Reingreso a Inventario" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Contenido Principal -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>

                    <!-- Tarjeta: Datos de la Factura de Origen Afectada -->
                    <Border Background="#F0F4F9" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 1 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FACTURA AFECTADA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtAffectedInvoice" Text="FAC-00000001" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" />
                            </StackPanel>

                            <!-- Col 2 -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="N° DE CONTROL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtAffectedControl" Text="00-00000001" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>

                            <!-- Col 3 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SERIAL FISCAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtAffectedSerial" Text="Z4A9876543" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>

                            <!-- Col 4 -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="FECHA FACTURA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtAffectedDate" Text="20/11/2026 20:50" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>

                            <!-- Fila 2: Cliente y Tasa -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="CLIENTE RECEPTOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtCustomerInfo" Text="Carlos Mendoza (V-18456789)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2">
                                <TextBlock Text="TASA CAMBIARIA APLICADA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtExchangeRateInfo" Text="1 USD = 55.4000 Bs." FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Título Renglones -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Artículos Facturados (Indique cantidades a devolver)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Click="BtnReturnAll_Click" Content="Devolver Todo" HorizontalAlignment="Right" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="8,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                    </Grid>

                    <!-- Tabla de Renglones a Devolver -->
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,14">
                        <DataGrid x:Name="DgReturnItems" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                                  BorderThickness="0" Background="White" RowHeight="38" MaxHeight="190" SelectionMode="Single">
                            <DataGrid.Columns>
                                <!-- Nombre Producto -->
                                <DataGridTemplateColumn Header="ARTÍCULO" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProductCode}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Alícuota IVA -->
                                <DataGridTemplateColumn Header="ALÍCUOTA" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VatRateDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cantidad Original -->
                                <DataGridTemplateColumn Header="FACTURADO" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OriginalQuantityDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Precio Unitario USD -->
                                <DataGridTemplateColumn Header="PRECIO ($)" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnitPriceDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Controles Cantidad a Devolver -->
                                <DataGridTemplateColumn Header="A DEVOLVER" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Click="BtnDecreaseItem_Click" Content="-" Width="22" Height="22" Background="#F0F0F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                                                <TextBlock Text="{Binding ReturnQuantityDisplay}" Width="36" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#D83B01" />
                                                <Button Click="BtnIncreaseItem_Click" Content="+" Width="22" Height="22" Background="#F0F0F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                                                <Button Click="BtnItemAll_Click" Content="Max" Width="30" Height="22" Margin="4,0,0,0" Background="#F4F4F4" BorderBrush="#D0D7DE" BorderThickness="1" Cursor="Hand" FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Devuelto USD -->
                                <DataGridTemplateColumn Header="TOTAL DEV. ($)" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ReturnTotalDisplay}" FontWeight="Bold" Foreground="#D83B01" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Formulario de Motivo y Opciones de Devolución -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col Izquierda: Motivo y Observaciones -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Motivo de la Devolución (Obligatorio SENIAT):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbReason" SelectedIndex="0" Padding="8,5" Margin="0,0,0,8">
                                <ComboBoxItem Content="Defecto o Avería en el Producto" />
                                <ComboBoxItem Content="Error en Facturación / Ítem Incorrecto" />
                                <ComboBoxItem Content="Disconformidad del Comprador / Solicitud de Cambio" />
                                <ComboBoxItem Content="Vencimiento de Producto" />
                                <ComboBoxItem Content="Garantía Comercial" />
                                <ComboBoxItem Content="Otro Motivo Justificado" />
                            </ComboBox>

                            <TextBlock Text="Observaciones / Justificación Detallada:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNotes" Height="45" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6,4" />

                            <!-- Checkbox Reembolso -->
                            <CheckBox x:Name="ChkRefundToCash" Content="Reembolsar dinero desde Caja Actual (Turno Abierto)" IsChecked="True" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Col Derecha: Tarjeta Resumen Fiscal de la Nota de Crédito -->
                        <Border Grid.Column="2" Background="#FFF8F6" BorderBrush="#F8D7DA" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel TextElement.FontSize="12">
                                <TextBlock Text="LIQUIDACIÓN FISCAL NOTA DE CRÉDITO" FontWeight="Bold" FontSize="11" Foreground="#D83B01" Margin="0,0,0,6" />

                                <Grid Margin="0,2">
                                    <TextBlock Text="Subtotal Exento:" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtNcSubExento" Text="$ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Base Imponible 16%:" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtNcBase16" Text="$ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="IVA Reversado (16%):" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtNcIva16" Text="$ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="IGTF Reversado (3%):" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtNcIgtf" Text="$ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>

                                <Separator Background="#F8D7DA" Margin="0,6" />

                                <!-- Total Final Nota de Crédito -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,2">
                                    <TextBlock Text="TOTAL NOTA DE CRÉDITO" FontSize="10" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtNcTotalUSD" Text="$ 0.00" FontSize="20" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtNcTotalVES" Text="0.00 Bs." FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="18,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="13" />
                    </Button>

                    <Button Grid.Column="3" Click="BtnSubmitCreditNote_Click" Background="#D83B01" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Emitir Nota de Crédito Fiscal" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

