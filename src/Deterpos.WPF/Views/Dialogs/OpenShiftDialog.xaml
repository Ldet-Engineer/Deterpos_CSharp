<Window x:Class="Deterpos.WPF.Views.Dialogs.OpenShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Apertura de Caja y Turno - Deterpos" 
        Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar x:Name="ContextBar" Grid.Row="0" 
                               Symbol="LockOpen" 
                               IconBrush="{StaticResource AccentGreenBrush}"
                               Text="Estación: POS-01 (Caja Principal)" />

            <!-- Formulario de Apertura -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>

                    <!-- Cajero Responsable -->
                    <TextBlock Text="Cajero / Operador Responsable *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtCashierName" Text="Administrador" Margin="0,0,0,14" />

                    <!-- Tarjeta Informativa de Tasa BCV -->
                    <Border Background="#EBF3FB" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tasa Oficial BCV del Día" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock x:Name="TxtBcvRateDisplay" Text="1 USD = 55.4000 Bs." FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <fluentIcons:SymbolIcon Grid.Column="1" Symbol="CurrencyDollarEuro" FontSize="20" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Fondo Inicial en USD -->
                    <TextBlock Text="Fondo Inicial en Divisas (USD $)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOpeningUSD" Text="50.00" TextChanged="TxtOpeningUSD_TextChanged" VerticalContentAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="USD $" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <!-- Fondo Inicial en Bolívares (VES) -->
                    <TextBlock Text="Fondo Inicial en Bolívares (Bs.)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOpeningVES" Text="2770.00" VerticalContentAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Bs. Digital" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <!-- Observaciones de Inicio -->
                    <TextBlock Text="Observaciones / Novedades de Apertura" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtNotes" Text="Apertura de turno ordinario" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="18,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <Button Grid.Column="3" Click="BtnOpen_Click" Background="{StaticResource AccentGreenBrush}" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Checkmark" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir Turno" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
</Window>
