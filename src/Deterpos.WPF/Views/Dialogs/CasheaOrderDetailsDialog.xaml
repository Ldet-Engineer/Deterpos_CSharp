<Window x:Class="Deterpos.WPF.Views.Dialogs.CasheaOrderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Detalle de Orden y Plan de Cuotas Cashea - Deterpos"
        Width="720" Height="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar Grid.Row="0"
                               Symbol="BarcodeScanner"
                               Text="Plan de cuotas quincenales y liquidación bancaria de la orden" />

        <!-- Contenido Principal -->
        <ScrollViewer Grid.Row="1" Margin="22,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Fila 1: Datos del Cliente, Estado y Venta -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DATOS DEL CLIENTE CASHEA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtCustomerInfo" Text="V-12345678 • Juan Pérez" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="TxtLevelInfo" Text="Nivel Cashea 3 • 3 Cuotas Quincenales" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="ESTADO EN CASHEA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border x:Name="BadgeStatus" Background="#FEF3C7" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtBadgeStatus" Text="Por Liquidar" FontSize="10.5" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TOTAL FACTURADO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtTotalSale" Text="$ 40.00 (2,216.00 Bs.)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                            <TextBlock x:Name="TxtExchangeRate" Text="Tasa BCV Aplicada: 55.4000 Bs./$" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fila 2: Desglose Inicial vs Financiado -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="INICIAL COBRADA EN TIENDA" FontSize="10" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtDownPaymentUSD" Text="$ 16.00" FontSize="18" FontWeight="Bold" Foreground="#15803D" />
                            <TextBlock x:Name="TxtDownPaymentDetails" Text="886.40 Bs. • Punto de Débito (Ref: 4892)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="TOTAL FINANCIADO CASHEA (60%)" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtFinancedUSD" Text="$ 24.00" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" />
                            <TextBlock x:Name="TxtFinancedVES" Text="1,329.60 Bs. • Asumido por Cashea" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fila 3: Cronograma de Cuotas del Cliente -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Cronograma de Pago al Cliente (3 Cuotas Quincenales sin Intereses)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="CUOTA 1 (14 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtQuota1Date" Text="Vence: 05/12/2026" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,4" />
                                    <TextBlock x:Name="TxtQuota1Amount" Text="$ 8.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TxtQuota1Ves" Text="443.20 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="CUOTA 2 (28 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtQuota2Date" Text="Vence: 19/12/2026" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,4" />
                                    <TextBlock x:Name="TxtQuota2Amount" Text="$ 8.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TxtQuota2Ves" Text="443.20 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="CUOTA 3 (42 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtQuota3Date" Text="Vence: 02/01/2027" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,4" />
                                    <TextBlock x:Name="TxtQuota3Amount" Text="$ 8.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TxtQuota3Ves" Text="443.20 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Fila 4: Liquidación Bancaria y Comisiones -->
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Liquidación Bancaria y Retención Comercial" FontWeight="Bold" FontSize="12.5" Foreground="#92400E" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Comisión Comercial Estimada (5%):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtCommission" Text="$ 1.20 USD" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="0,2,0,6" />

                                <TextBlock Text="Monto Neto a Transferir por Cashea:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtNetSettlement" Text="$ 22.80 USD" FontWeight="Bold" FontSize="14" Foreground="#047857" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Referencia de Transferencia Bancaria:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtBankReference" Text="Pendiente por liquidar" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,6" />

                                <TextBlock Text="Fecha de Liquidación:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtSettlementDate" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <TextBlock Text="Las ventas Cashea se liquidan periódicamente a la cuenta del comercio." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button Click="BtnClose_Click" HorizontalAlignment="Right" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0" Padding="20,8" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Cerrar" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
