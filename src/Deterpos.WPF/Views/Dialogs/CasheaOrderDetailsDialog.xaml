<Window x:Class="Deterpos.WPF.Views.Dialogs.CasheaOrderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Detalle de Orden y Plan de Cuotas Cashea"
        Width="720" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F0F9FF" CornerRadius="12,12,0,0" Padding="22,14" BorderBrush="#BAE6FD" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0284C7" CornerRadius="8" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="BarcodeScanner" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtHeaderOrderNum" Text="Orden Cashea #CSH-00000" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            <Border x:Name="BadgeStatus" Background="#FEF3C7" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBadgeStatus" Text="Por Liquidar" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtHeaderDate" Text="Emitida el 21/11/2026 23:00" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Contenido Principal -->
            <ScrollViewer Grid.Row="1" Margin="22,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Fila 1: Datos del Cliente y Venta -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DATOS DEL CLIENTE CASHEA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtCustomerInfo" Text="V-12345678 • Juan Pérez" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtLevelInfo" Text="Nivel Cashea 3 (40% Inicial / 60% Financiado)" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOTAL VENTA FACTURADA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtTotalSale" Text="$ 40.00 USD (2,216.00 Bs.)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock x:Name="TxtExchangeRate" Text="Tasa BCV Aplicada: 55.40 Bs./$" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fila 2: Inicial vs Financiado -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Inicial -->
                        <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="INICIAL COBRADA EN CAJA" FontSize="10" FontWeight="Bold" Foreground="#047857" />
                                <TextBlock x:Name="TxtDownPaymentUSD" Text="$ 16.00" FontSize="18" FontWeight="Bold" Foreground="#065F46" Margin="0,2,0,2" />
                                <TextBlock x:Name="TxtDownPaymentDetails" Text="886.40 Bs. • Punto de Débito" FontSize="11" Foreground="#047857" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Financiado -->
                        <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="SALDO FINANCIADO POR CASHEA" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" />
                                <TextBlock x:Name="TxtFinancedUSD" Text="$ 24.00" FontSize="18" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,2" />
                                <TextBlock x:Name="TxtFinancedVES" Text="1,329.60 Bs. • 3 Cuotas Quincenales" FontSize="11" Foreground="#1D4ED8" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila 3: Las 3 Cuotas Quincenales -->
                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fluentIcons:SymbolIcon Symbol="Clock" FontSize="15" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cronograma de Cuotas Quincenales sin Intereses" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="El cliente abona a Cashea" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CUOTA 1 (14 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtQuota1Date" Text="Vence: 05/12/2026" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtQuota1Amount" Text="$ 8.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtQuota1Ves" Text="443.20 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CUOTA 2 (28 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtQuota2Date" Text="Vence: 19/12/2026" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtQuota2Amount" Text="$ 8.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtQuota2Ves" Text="443.20 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CUOTA 3 (42 DÍAS)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtQuota3Date" Text="Vence: 02/01/2027" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtQuota3Amount" Text="$ 8.00" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtQuota3Ves" Text="443.20 Bs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Fila 4: Liquidación Bancaria y Comisiones -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Liquidación Bancaria y Retención Comercial" FontWeight="Bold" FontSize="12.5" Foreground="#92400E" Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Comisión Comercial Estimada (5%):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCommission" Text="$ 1.20 USD" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="0,2,0,6" />

                                    <TextBlock Text="Monto Neto a Transferir por Cashea:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtNetSettlement" Text="$ 22.80 USD" FontWeight="Bold" FontSize="14" Foreground="#047857" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Referencia de Transferencia Bancaria:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtBankReference" Text="Pendiente por liquidar" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,6" />

                                    <TextBlock Text="Fecha de Liquidación:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtSettlementDate" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,14">
                <Grid>
                    <TextBlock Text="Las ventas Cashea se liquidan periódicamente a la cuenta del comercio." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0" Padding="20,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cerrar" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
