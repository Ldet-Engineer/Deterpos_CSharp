<Window x:Class="Deterpos.WPF.Views.Dialogs.PurchaseDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Detalle de Factura de Compra - Deterpos" 
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar x:Name="ContextBar" Grid.Row="0" 
                               Symbol="DocumentTable" 
                               Text="Factura Proveedor • Libro de Compras SENIAT" />

            <!-- Contenido Principal -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>

                    <!-- Tarjeta Datos del Proveedor y Factura -->
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="PROVEEDOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtSupplierName" Text="Distribuidora Polar C.A." FontWeight="Bold" FontSize="13" />
                                <TextBlock x:Name="TxtSupplierRif" Text="RIF: J-00041372-9" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="N° FACTURA PROVEEDOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtInvoiceNum" Text="FAC-0045210" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="N° CONTROL SENIAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtControlNum" Text="00-00129482" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="FECHA RECEPCIÓN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtReceivedDate" Text="20/11/2026 21:00" FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="CONDICIÓN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtCondition" Text="Contado" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="TASA BCV" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtRateBcv" Text="55.4000 Bs./USD" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabla de Renglones Recibidos -->
                    <TextBlock Text="Renglones de Mercancía Recibida:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,12">
                        <DataGrid x:Name="DgDetails" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                                  BorderThickness="0" Background="White" RowHeight="34" MaxHeight="190">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding ProductCode}" Width="85" />
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity, StringFormat={}{0:G29}}" Width="75" />
                                <DataGridTextColumn Header="COSTO ($)" Binding="{Binding UnitCostUSD, StringFormat={}${0:N2}}" Width="85" />
                                <DataGridTextColumn Header="TOTAL ($)" Binding="{Binding TotalPriceUSD, StringFormat={}${0:N2}}" Width="85" />
                                <DataGridTextColumn Header="NUEVO COSTO PROM." Binding="{Binding NewCostUSD, StringFormat={}${0:N2}}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Desglose de Totales -->
                    <Border Background="#F6F8FA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <!-- Observaciones -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="OBSERVACIONES / REGISTRO:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtNotes" Text="Sin observaciones adicionales." FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtRegisteredBy" Text="Recibido por: Administrador" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Totales -->
                            <StackPanel Grid.Column="2" TextElement.FontSize="12">
                                <Grid Margin="0,2">
                                    <TextBlock Text="Subtotal Exento:" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtSubExento" Text="$ 0.00" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Base Imponible (16%):" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtBase16" Text="$ 0.00" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Crédito Fiscal IVA:" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtIva16" Text="$ 0.00" HorizontalAlignment="Right" />
                                </Grid>
                                <Separator Background="#E1E4E8" Margin="0,4" />
                                <Grid Margin="0,2">
                                    <TextBlock Text="TOTAL COMPRA ($):" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                    <TextBlock x:Name="TxtTotalUSD" Text="$ 0.00" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBrandBrush}" />
                                </Grid>
                                <Grid Margin="0,1">
                                    <TextBlock Text="TOTAL (Bs.):" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                                    <TextBlock x:Name="TxtTotalVES" Text="0.00 Bs." FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentGreenBrush}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior -->
            <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Button HorizontalAlignment="Right" Click="BtnClose_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                        Padding="22,7" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Cerrar" FontSize="13" />
                </Button>
            </Border>
        </Grid>
</Window>

