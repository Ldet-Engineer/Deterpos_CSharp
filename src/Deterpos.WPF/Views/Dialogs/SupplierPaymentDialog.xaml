<Window x:Class="Deterpos.WPF.Views.Dialogs.SupplierPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Registrar Pago a Proveedor - Deterpos" 
        Height="610" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar Grid.Row="0" 
                               Symbol="Payment" 
                               IconBrush="#8E562E"
                               Text="Cuentas por Pagar (CxP) • Amortización de Deuda" />

            <!-- Formulario de Pago -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>

                    <!-- Tarjeta Datos del Proveedor y Saldo Deudor -->
                    <Border Background="#FFF8F0" BorderBrush="#FED9B7" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSupplierName" Text="Distribuidora Polar C.A." FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtSupplierRif" Text="RIF: J-00041372-9" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtContactName" Text="Contacto: Juan Pérez" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="DEUDA PENDIENTE" FontSize="10" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Right" />
                                <TextBlock x:Name="TxtCurrentDebtUSD" Text="$ 450.00" FontSize="18" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Right" />
                                <TextBlock x:Name="TxtCurrentDebtVES" Text="24,930.00 Bs." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Moneda del Pago y Tasa Oficial -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Moneda del Pago:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbCurrency" SelectedIndex="0" SelectionChanged="CmbCurrency_SelectionChanged" Padding="8,5">
                                <ComboBoxItem Content="Dólares USD ($)" />
                                <ComboBoxItem Content="Bolívares VES (Bs.)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tasa Oficial BCV:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtBcvRate" IsReadOnly="True" Background="#F0F0F0" Padding="8,5" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <!-- Monto a Pagar -->
                    <TextBlock Text="Monto a Pagar:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtAmountInput" Text="0.00" Padding="10,6" FontSize="14" FontWeight="Bold" TextChanged="TxtAmountInput_TextChanged" />
                        <Button Grid.Column="2" Click="BtnPayAll_Click" Content="Pagar Total" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" />
                    </Grid>

                    <!-- Equivalencia en USD si pagó en Bs -->
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Equivalente Amortizado en USD:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtEquivalentUSD" Text="$ 0.00 USD" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Método de Pago -->
                    <TextBlock Text="Método de Pago:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbPaymentMethod" SelectedIndex="3" Padding="8,5" Margin="0,0,0,10" SelectionChanged="CmbPaymentMethod_SelectionChanged">
                        <ComboBoxItem Content="Efectivo USD ($)" />
                        <ComboBoxItem Content="Pago Móvil (Bs.)" />
                        <ComboBoxItem Content="Punto de Venta / Débito (Bs.)" />
                        <ComboBoxItem Content="Transferencia Bancaria" />
                        <ComboBoxItem Content="Zelle USD" />
                        <ComboBoxItem Content="Efectivo Bolívares (Bs.)" />
                    </ComboBox>

                    <!-- N° de Referencia -->
                    <TextBlock Text="N° de Transferencia / Referencia:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtReferenceNumber" Padding="8,5" Margin="0,0,0,10" />

                    <!-- Opciones de Caja -->
                    <CheckBox x:Name="ChkPayFromCashShift" Content="Egresar efectivo de Caja Actual (Turno Abierto)" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <!-- Notas -->
                    <TextBlock Text="Notas / Factura Afectada:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtNotes" Height="40" TextWrapping="Wrap" Padding="6,4" Margin="0,0,0,10" />

                    <!-- Deuda Proyectada Resultante -->
                    <Border Background="#F0F7FF" BorderBrush="#CCE4F7" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <TextBlock Text="Deuda Pendiente Resultante:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtProjectedDebt" Text="$ 0.00 USD" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="13" />
                    </Button>

                    <Button Grid.Column="3" Click="BtnSubmitPayment_Click" Background="#8E562E" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Registrar Pago" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
</Window>

