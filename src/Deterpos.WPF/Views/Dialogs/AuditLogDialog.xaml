<Window x:Class="Deterpos.WPF.Views.Dialogs.AuditLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Pistas de Auditoría y Seguridad Operativa - Deterpos"
        Height="620" Width="850"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar Grid.Row="0"
                               Symbol="History"
                               Text="Registro cronológico inmutable de eventos sensibles del sistema" />

        <!-- DataGrid de Auditoría -->
        <Grid Grid.Row="1" Margin="20,16">
            <DataGrid x:Name="GridAudit" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      BorderThickness="1" BorderBrush="#E2E8F0" Background="White" HeadersVisibility="Column"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA / HORA" Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="145" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" Width="110" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                    <DataGridTextColumn Header="MÓDULO" Binding="{Binding Module}" Width="100" />
                    <DataGridTextColumn Header="ACCIÓN" Binding="{Binding Action}" Width="140" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="DETALLES DE LA OPERACIÓN" Binding="{Binding Details}" Width="*" />
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="90" Foreground="{StaticResource TextSecondaryBrush}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Botón Inferior Cerrar -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Click="BtnClose_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                    Padding="20,8" HorizontalAlignment="Right" Cursor="Hand" FontWeight="SemiBold" FontSize="13">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
                <TextBlock Text="Cerrar" />
            </Button>
        </Border>
    </Grid>
</Window>
