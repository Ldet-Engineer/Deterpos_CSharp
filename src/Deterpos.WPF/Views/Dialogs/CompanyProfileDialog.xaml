<Window x:Class="Deterpos.WPF.Views.Dialogs.CompanyProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Editar Perfil de la Empresa • Deterpos ERP"
        Width="680" Height="730"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Window.Resources>
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.30" Color="#000000" />
    </Window.Resources>

    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="14" Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR / HEADER -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E0F2FE" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <fluentIcons:SymbolIcon Symbol="Building" FontSize="20" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Perfil y Datos de la Empresa" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Información jurídica, tributaria SENIAT y sucursal de operaciones" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- CUERPO DEL FORMULARIO -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>
                    <!-- Bloque de Error si hay validación fallida -->
                    <Border x:Name="BrdError" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Warning" FontSize="18" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtError" Foreground="#B91C1C" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- GRUPO 1: IDENTIFICACIÓN JURÍDICA Y TRIBUTARIA -->
                    <TextBlock Text="IDENTIFICACIÓN JURÍDICA Y TRIBUTARIA (SENIAT)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,0,10" />

                    <!-- Razón Social -->
                    <TextBlock Text="Razón Social (Nombre Legal Registrado):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TxtBusinessName" Padding="10,7" Margin="0,0,0,12" FontSize="13" />

                    <!-- Nombre Comercial -->
                    <TextBlock Text="Nombre Comercial (Firma / Marca de Mostrador):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TxtTradeName" Padding="10,7" Margin="0,0,0,12" FontSize="13" />

                    <!-- RIF -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Tipo RIF:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ComboBox x:Name="CmbRifPrefix" Padding="8,6" FontSize="13">
                                <ComboBoxItem Content="J - Jurídico" Tag="J" IsSelected="True" />
                                <ComboBoxItem Content="V - Venezolano" Tag="V" />
                                <ComboBoxItem Content="G - Gobierno" Tag="G" />
                                <ComboBoxItem Content="E - Extranjero" Tag="E" />
                                <ComboBoxItem Content="P - Pasaporte" Tag="P" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Número de RIF (sin guiones o con formato SENIAT):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox x:Name="TxtRifNumber" Padding="10,7" FontSize="13" ToolTip="Ejemplo: 40918273-0 o 409182730" />
                        </StackPanel>
                    </Grid>

                    <!-- Sujeto Pasivo Especial -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <CheckBox x:Name="ChkSpecialTaxpayer" Content="Empresa designada como Sujeto Pasivo Especial (Contribuyente Especial SENIAT)" FontWeight="SemiBold" FontSize="12.5" />
                    </Border>

                    <!-- GRUPO 2: DOMICILIO FISCAL Y CONTACTO -->
                    <TextBlock Text="DOMICILIO FISCAL Y CANALES DE CONTACTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,4,0,10" />

                    <TextBlock Text="Domicilio Fiscal Completo (Dirección SENIAT):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TxtFiscalAddress" Padding="10,7" Margin="0,0,0,12" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True" Height="55" VerticalScrollBarVisibility="Auto" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Teléfono Fijo / Principal:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox x:Name="TxtPhone" Padding="10,7" FontSize="12.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Correo Electrónico (Facturación):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox x:Name="TxtEmail" Padding="10,7" FontSize="12.5" />
                        </StackPanel>
                    </Grid>

                    <!-- GRUPO 3: PARÁMETROS DE SUCURSAL Y PUNTO DE VENTA -->
                    <TextBlock Text="SUCURSAL Y TERMINAL DE OPERACIONES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,4,0,10" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Nombre de Sucursal:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox x:Name="TxtBranchName" Text="Sucursal Principal" Padding="10,7" FontSize="12.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Terminal / Punto de Venta:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox x:Name="TxtTerminalName" Text="Caja Principal Mostrador 01" Padding="10,7" FontSize="12.5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- BARRA INFERIOR / BOTONES DE ACCIÓN -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="BtnCancel_Click" Content="Cancelar" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" 
                            Padding="16,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnSave" Click="BtnSave_Click" Content="Guardar Perfil de Empresa" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0" 
                            Padding="20,8" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>