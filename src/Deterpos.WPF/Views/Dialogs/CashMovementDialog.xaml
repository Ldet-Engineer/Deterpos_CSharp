<Window x:Class="Deterpos.WPF.Views.Dialogs.CashMovementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Movimiento de Caja" 
        Height="540" Width="490"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="22,16" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon x:Name="IconHeader" Grid.Column="0" Symbol="ArrowSwap" FontSize="26" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtModalTitle" Text="Movimiento de Efectivo" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Entradas y Salidas de Caja Chica con soporte justificativo" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Formulario de Movimiento -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>

                    <!-- Tipo de Movimiento -->
                    <TextBlock Text="Tipo de Movimiento *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbMovementType" SelectedIndex="0" SelectionChanged="CmbMovementType_SelectionChanged" Margin="0,0,0,14">
                        <ComboBoxItem Content="Salida de Caja Chica (Egreso / Gasto Menor)" Tag="Egreso" />
                        <ComboBoxItem Content="Entrada de Efectivo (Ingreso Manual / Sencillo)" Tag="Ingreso" />
                    </ComboBox>

                    <!-- Moneda Principal del Movimiento -->
                    <TextBlock Text="Moneda del Movimiento *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbCurrency" SelectedIndex="0" SelectionChanged="CmbCurrency_SelectionChanged" Margin="0,0,0,14">
                        <ComboBoxItem Content="Dólares Americanos (USD $)" Tag="USD" />
                        <ComboBoxItem Content="Bolívares Digitales (VES / Bs.)" Tag="VES" />
                    </ComboBox>

                    <!-- Monto -->
                    <TextBlock x:Name="TxtAmountLabel" Text="Monto en USD ($) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAmount" Text="10.00" TextChanged="TxtAmount_TextChanged" VerticalContentAlignment="Center" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="TxtAmountBadge" Grid.Column="1" Text="USD $" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <!-- Conversión Referencial al BCV -->
                    <Border Background="#F6F8FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Info" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtConversionDisplay" Text="Equivalente referencial: 554.00 Bs. (Tasa BCV: 55.40)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Motivo / Justificación -->
                    <TextBlock Text="Motivo o Justificación del Movimiento *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtDescription" Text="Compra de artículos de limpieza menores para la sucursal" Margin="0,0,0,14" />

                    <!-- Autorizado Por -->
                    <TextBlock Text="Autorizado por (Supervisor / Gerente) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAuthorizedBy" Text="Administrador" />

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="22,14" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="18,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <Button x:Name="BtnSave" Grid.Column="3" Click="BtnSave_Click" Background="#D83B01" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Checkmark" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtBtnSave" Text="Registrar Salida" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
