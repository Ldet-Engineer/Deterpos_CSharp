<Window x:Class="Deterpos.WPF.Views.Dialogs.CustomerPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Registrar Abono de Cliente" 
        Height="630" Width="520"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="20,14" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="MoneyHand" FontSize="26" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Registrar Abono / Cobranza de Cliente" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Cuentas por Cobrar (CxC) • Amortización de Saldo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Formulario de Cobro -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>

                    <!-- Tarjeta Datos del Cliente y Saldo Deudor -->
                    <Border Background="#F0F7FF" BorderBrush="#CCE4F7" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtCustomerName" Text="Carlos Mendoza" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtCustomerDoc" Text="Cédula/RIF: V-18456789" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtCreditLimitInfo" Text="Límite de Crédito: $ 500.00" FontSize="11" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="DEUDA PENDIENTE" FontSize="10" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Right" />
                                <TextBlock x:Name="TxtCurrentBalanceUSD" Text="$ 120.00" FontSize="18" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Right" />
                                <TextBlock x:Name="TxtCurrentBalanceVES" Text="6,648.00 Bs." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Moneda del Pago y Tasa Oficial -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Moneda del Abono:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbCurrency" SelectedIndex="0" SelectionChanged="CmbCurrency_SelectionChanged" Padding="8,5">
                                <ComboBoxItem Content="Dólares USD ($)" />
                                <ComboBoxItem Content="Bolívares VES (Bs.)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tasa Oficial BCV:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtBcvRate" IsReadOnly="True" Background="#F0F0F0" Padding="8,5" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <!-- Monto a Abonar -->
                    <TextBlock Text="Monto a Abonar:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtAmountInput" Text="0.00" Padding="10,6" FontSize="14" FontWeight="Bold" TextChanged="TxtAmountInput_TextChanged" />
                        <Button Grid.Column="2" Click="BtnPayAll_Click" Content="Pagar Total" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" />
                    </Grid>

                    <!-- Equivalencia en USD si pagó en Bs -->
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Equivalente Amortizado en USD:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtEquivalentUSD" Text="$ 0.00 USD" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Método de Pago -->
                    <TextBlock Text="Método de Pago:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbPaymentMethod" SelectedIndex="0" Padding="8,5" Margin="0,0,0,10">
                        <ComboBoxItem Content="Efectivo USD ($)" />
                        <ComboBoxItem Content="Pago Móvil (Bs.)" />
                        <ComboBoxItem Content="Punto de Venta / Débito (Bs.)" />
                        <ComboBoxItem Content="Transferencia Bancaria" />
                        <ComboBoxItem Content="Zelle USD" />
                        <ComboBoxItem Content="Efectivo Bolívares (Bs.)" />
                    </ComboBox>

                    <!-- N° de Referencia -->
                    <TextBlock Text="N° de Referencia / Comprobante:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtReferenceNumber" Padding="8,5" Margin="0,0,0,10" />

                    <!-- Opciones de Caja -->
                    <CheckBox x:Name="ChkSendToCashShift" Content="Ingresar efectivo a Caja Actual (Turno Abierto)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <!-- Notas -->
                    <TextBlock Text="Notas / Concepto:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox x:Name="TxtNotes" Height="40" TextWrapping="Wrap" Padding="6,4" Margin="0,0,0,10" />

                    <!-- Saldo Proyectado Resultante -->
                    <Border Background="#E6F4EA" BorderBrush="#34A853" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid>
                            <TextBlock Text="Saldo Pendiente Resultante:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtProjectedBalance" Text="$ 0.00 USD" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnCancel_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="13" />
                    </Button>

                    <Button Grid.Column="3" Click="BtnSubmitPayment_Click" Background="{StaticResource AccentGreenBrush}" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Registrar Abono" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

