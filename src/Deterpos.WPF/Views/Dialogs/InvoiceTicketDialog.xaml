<Window x:Class="Deterpos.WPF.Views.Dialogs.InvoiceTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Comprobante Fiscal SENIAT" 
        Height="730" Width="440"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="18,14" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Receipt" FontSize="22" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Factura Fiscal Emitida" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TxtInvoiceHeaderSub" Text="Documento Fiscal Homologado SENIAT" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Vista del Ticket Térmico / Fiscal 80mm -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel TextElement.FontFamily="Consolas, Lucida Console, Courier New" TextElement.FontSize="11">

                        <!-- Datos del Emisor -->
                        <TextBlock Text="DETERPOS C.A." FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="RIF: J-409182730" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="SUJETO PASIVO ESPECIAL SENIAT" HorizontalAlignment="Center" FontSize="10" />
                        <TextBlock Text="Av. Principal, Edif. Empresarial, Piso 1" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="Telf: (0212) 555-1234 • Caracas" HorizontalAlignment="Center" FontSize="9" />

                        <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Datos Fiscales del Documento -->
                        <TextBlock x:Name="TxtFiscalDocNum" Text="FACTURA FISCAL: FAC-00000001" FontWeight="Bold" />
                        <TextBlock x:Name="TxtFiscalControlNum" Text="N° DE CONTROL SENIAT: 00-00000001" />
                        <TextBlock x:Name="TxtFiscalSerial" Text="SERIAL FISCAL: Z4A9876543" />
                        <TextBlock x:Name="TxtFiscalDateTime" Text="FECHA: 20/11/2026  HORA: 20:50" />
                        <TextBlock x:Name="TxtFiscalCashier" Text="CAJERO: Administrador  (POS-01)" />
                        <TextBlock x:Name="TxtAffectedInvoiceNotice" Text="FACTURA AFECTADA: FAC-00000001" FontWeight="Bold" Foreground="#D83B01" Visibility="Collapsed" />

                        <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Datos del Cliente -->
                        <TextBlock x:Name="TxtCustomerName" Text="CLIENTE: Carlos Mendoza" FontWeight="Bold" />
                        <TextBlock x:Name="TxtCustomerDoc" Text="C.I./RIF: V-18456789" />
                        <TextBlock x:Name="TxtCustomerAddress" Text="DIR: Urb. Los Rosales, Caracas" TextWrapping="Wrap" />

                        <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Cabecera de Ítems -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CANT" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="DESCRIPCIÓN" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="P.UNIT($)" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="TOTAL($)" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Lista de Ítems -->
                        <ItemsControl x:Name="IcItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding QuantityDisplay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DescriptionWithTaxTag}" TextTrimming="CharacterEllipsis" Margin="2,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding UnitPriceDisplay}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalPriceDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Desglose de Alícuotas e Impuestos -->
                        <Grid Margin="0,1">
                            <TextBlock Text="SUBTOTAL EXENTO (0%):" />
                            <TextBlock x:Name="TxtSubExento" Text="$ 0.00" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,1">
                            <TextBlock Text="BASE IMPONIBLE (G) 16%:" />
                            <TextBlock x:Name="TxtBaseGeneral" Text="$ 0.00" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,1">
                            <TextBlock Text="IMPUESTO IVA 16%:" />
                            <TextBlock x:Name="TxtIvaGeneral" Text="$ 0.00" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,1">
                            <TextBlock Text="BASE IMPONIBLE IGTF 3%:" />
                            <TextBlock x:Name="TxtBaseIgtf" Text="$ 0.00" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,1">
                            <TextBlock Text="IMPUESTO IGTF 3% (DIVISAS):" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtIgtfAmount" Text="$ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>

                        <TextBlock Text="========================================" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Totales Finales -->
                        <Grid Margin="0,2">
                            <TextBlock Text="TOTAL FACTURA (USD $):" FontWeight="Bold" FontSize="13" />
                            <TextBlock x:Name="TxtGrandTotalUSD" Text="$ 0.00" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="TOTAL FACTURA (Bs.):" FontWeight="Bold" FontSize="12" />
                            <TextBlock x:Name="TxtGrandTotalVES" Text="0.00 Bs." FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TxtRateBcvDisplay" Text="TASA OFICIAL BCV: 55.4000 Bs./USD" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,6" />

                        <TextBlock Text="----------------------------------------" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Formas de Pago Recibidas -->
                        <TextBlock Text="FORMAS DE PAGO APLICADAS:" FontWeight="Bold" Margin="0,0,0,2" />
                        <ItemsControl x:Name="IcPayments">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <TextBlock Text="{Binding SummaryLine}" />
                                        <TextBlock Text="{Binding AmountDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="========================================" HorizontalAlignment="Center" Margin="0,6" />

                        <!-- Pie Fiscal SENIAT -->
                        <TextBlock Text="Providencia SENIAT SNAT/2011/00071" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Text="Providencia 000141 (Impresora Fiscal)" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Text="¡GRACIAS POR SU COMPRA!" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,6,0,0" />

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Barra Inferior de Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Click="BtnPrint_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Print" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Imprimir Ticket" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Click="BtnClose_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                            Padding="22,8" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cerrar y Nueva Venta" FontSize="13" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
