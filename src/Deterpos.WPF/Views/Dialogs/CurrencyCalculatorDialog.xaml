<Window x:Class="Deterpos.WPF.Views.Dialogs.CurrencyCalculatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Calculadora Multimoneda" 
        Height="500" Width="460"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="20,16" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Calculator" FontSize="24" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Calculadora Multimoneda" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Conversión instantánea con paridades del día" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Cuerpo del Convertidor -->
            <Border Grid.Row="1" Padding="24,20">
                <StackPanel>

                    <!-- Monto a Convertir -->
                    <TextBlock Text="Monto a Convertir:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAmount" Text="10.00" FontSize="20" FontWeight="Bold" Padding="12,8" Margin="0,0,0,16"
                             TextChanged="TxtAmount_TextChanged" BorderBrush="{StaticResource PrimaryBrandBrush}" BorderThickness="1.5" />

                    <!-- Selector De / A -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- De -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="De Moneda:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbFromCurrency" SelectedIndex="0" Padding="10,8" SelectionChanged="CmbCurrency_SelectionChanged">
                                <ComboBoxItem Content="USD - Dólar ($)" Tag="USD" />
                                <ComboBoxItem Content="VES - Bolívar (Bs.)" Tag="VES" />
                                <ComboBoxItem Content="EUR - Euro (€)" Tag="EUR" />
                                <ComboBoxItem Content="COP - Peso (Col$)" Tag="COP" />
                            </ComboBox>
                        </StackPanel>

                        <fluentIcons:SymbolIcon Grid.Column="1" Symbol="ArrowRight" FontSize="18" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />

                        <!-- A -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="A Moneda:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbToCurrency" SelectedIndex="1" Padding="10,8" SelectionChanged="CmbCurrency_SelectionChanged">
                                <ComboBoxItem Content="USD - Dólar ($)" Tag="USD" />
                                <ComboBoxItem Content="VES - Bolívar (Bs.)" Tag="VES" />
                                <ComboBoxItem Content="EUR - Euro (€)" Tag="EUR" />
                                <ComboBoxItem Content="COP - Peso (Col$)" Tag="COP" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Tarjeta de Resultado Grande -->
                    <Border Background="#F4F6F9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL CONVERTIDO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtResult" Text="554.00 Bs." FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" Margin="0,6,0,4" />
                            <TextBlock x:Name="TxtDetail" Text="Tasa aplicada: 1 USD = 55.4000 VES (BCV)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Button Click="BtnClose_Click" Content="Cerrar Calculadora" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                        Padding="22,8" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Right">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Border>

        </Grid>
    </Border>
</Window>

