<Window x:Class="Deterpos.WPF.Views.Dialogs.ProductFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:ctrl="clr-namespace:Deterpos.WPF.Controls"
        Title="Nuevo Producto - Deterpos" 
        Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Franja Contextual Reutilizable -->
        <ctrl:DialogContextBar x:Name="ContextBar" Grid.Row="0" 
                               Symbol="Box" 
                               Text="Costeo en USD, paridad en Bolívares y alícuota tributaria SENIAT" />

            <!-- Formulario con Scroll -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel>

                    <!-- Códigos -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Código Interno -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Código Interno *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCode" Text="PROD-001" />
                        </StackPanel>

                        <!-- Código de Barras -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Código de Barras (EAN / UPC)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Button Click="BtnGenBarcode_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Generar aleatorio">
                                    <TextBlock Text="Generar" FontSize="11" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                            <TextBox x:Name="TxtBarcode" Text="7591001001015" />
                        </StackPanel>
                    </Grid>

                    <!-- Nombre del Producto -->
                    <TextBlock Text="Nombre del Producto o Artículo *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtName" Text="" Margin="0,0,0,14" />

                    <!-- Categoría y Alícuota SENIAT (CON COMBOBOXES MODERNOS) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Categoría -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Categoría *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbCategory" SelectedIndex="0" />
                        </StackPanel>

                        <!-- Alícuota SENIAT -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Alícuota IVA SENIAT *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbVatRate" SelectedIndex="0" SelectionChanged="PriceInputs_Changed">
                                <ComboBoxItem Content="General (16% IVA)" Tag="16" />
                                <ComboBoxItem Content="Exento / Exonerado (0% IVA)" Tag="0" />
                                <ComboBoxItem Content="Reducida (8% IVA)" Tag="8" />
                                <ComboBoxItem Content="Suntuaria / Lujo (31% IVA)" Tag="31" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- TARJETA MULTIMONEDA: COSTOS Y PRECIOS -->
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="PRECIOS Y COSTEO MULTIMONEDA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock x:Name="TxtBcvRateBadge" Text="Tasa BCV: 55.40 Bs." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Costo USD -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Costo ($ USD) *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtCostUSD" Text="1.0000" TextChanged="PriceInputs_Changed" />
                                </StackPanel>

                                <!-- Margen % -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="% Margen" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtMarginPercent" Text="30" TextChanged="PriceInputs_Changed" />
                                </StackPanel>

                                <!-- Precio Venta USD -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="PVP ($ USD) *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtPriceUSD" Text="1.3000" FontWeight="Bold" BorderBrush="{StaticResource PrimaryBrandBrush}" BorderThickness="1.5" TextChanged="PriceUSD_DirectChanged" />
                                </StackPanel>
                            </Grid>

                            <!-- Equivalente Calculado al Vuelo en Bolívares -->
                            <Border Background="White" BorderBrush="#CCE4F7" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PVP Fiscal en Bolívares (VES de Curso Legal):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtPriceVES" Text="72.02 Bs." FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                    </StackPanel>
                                    <fluentIcons:SymbolIcon Grid.Column="1" Symbol="ReceiptMoney" FontSize="24" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Control de Stock -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Stock Inicial -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Stock Actual / Inicial" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCurrentStock" Text="25.00" />
                        </StackPanel>

                        <!-- Stock Mínimo -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock Mínimo (Alerta de Agotamiento)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtMinStock" Text="5.00" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Barra de Acciones Inferior -->
            <Border Grid.Row="2" Background="#F8FAFC" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="BtnCancel_Click" Content="Cancelar" Background="Transparent" BorderBrush="#D0D7DE" BorderThickness="1"
                            Padding="16,8" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Click="BtnSave_Click" Content="Guardar Producto" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                            Padding="22,8" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
</Window>

