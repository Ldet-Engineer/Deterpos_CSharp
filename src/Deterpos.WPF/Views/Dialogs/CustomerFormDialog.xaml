<Window x:Class="Deterpos.WPF.Views.Dialogs.CustomerFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Formulario de Cliente" 
        Height="610" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado Modal -->
        <Border Grid.Row="0" Background="#F6F8FA" Padding="22,14" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <fluentIcons:SymbolIcon Grid.Column="0" Symbol="PersonAdd" FontSize="26" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModalTitle" Text="Nuevo Cliente" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Datos fiscales para facturación SENIAT y créditos comerciales" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>

                <!-- Identificación Fiscal (RIF / Cédula) -->
                <TextBlock Text="Documento de Identidad / RIF Fiscal *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- ComboBox Moderno de Prefijo -->
                    <ComboBox x:Name="CmbDocPrefix" Grid.Column="0" SelectedIndex="0">
                        <ComboBoxItem Content="V-" Tag="V-" />
                        <ComboBoxItem Content="J-" Tag="J-" />
                        <ComboBoxItem Content="E-" Tag="E-" />
                        <ComboBoxItem Content="G-" Tag="G-" />
                    </ComboBox>
                    <TextBox x:Name="TxtDocNumber" Grid.Column="2" Text="" VerticalContentAlignment="Center" />
                </Grid>

                <!-- Nombre Completo / Razón Social -->
                <TextBlock Text="Nombre Completo o Razón Social *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtFullName" Text="" Margin="0,0,0,14" />

                <!-- Teléfono y Correo -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono de Contacto" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtPhone" Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Correo Electrónico" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtEmail" Text="" />
                    </StackPanel>
                </Grid>

                <!-- Dirección Fiscal SENIAT -->
                <TextBlock Text="Dirección Fiscal (Requisito SENIAT) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtAddress" Text="" Margin="0,0,0,14" Height="50" AcceptsReturn="True" TextWrapping="Wrap" />

                <!-- Límite de Crédito en USD -->
                <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Límite de Crédito Comercial ($ USD):" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Monto máximo que el cliente puede adeudar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBox x:Name="TxtCreditLimitUSD" Grid.Column="1" Text="0.00" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Acciones Inferiores -->
        <Border Grid.Row="2" Background="#F6F8FA" Padding="22,14" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnCancel_Click" Content="Cancelar" Style="{StaticResource ModernOutlineActionButtonStyle}"
                        Padding="16,8" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Click="BtnSave_Click" Content="Guardar Cliente" Style="{StaticResource ModernPrimaryActionButtonStyle}"
                        Padding="22,8" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>

