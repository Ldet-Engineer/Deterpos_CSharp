<Window x:Class="Deterpos.WPF.Views.Dialogs.QuotationTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Presupuesto y Cotización Comercial" 
        Height="730" Width="440"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <!-- Sombra Perimetral Moderna -->
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="18,14" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="DocumentBulletList" FontSize="22" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cotización / Presupuesto" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Documento Comercial Informativo (No Fiscal)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Vista del Ticket Térmico / Hoja de Presupuesto 80mm -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel TextElement.FontFamily="Consolas, Lucida Console, Courier New" TextElement.FontSize="11">

                        <!-- Datos del Emisor -->
                        <TextBlock Text="DETERPOS C.A." FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="RIF: J-409182730" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="Av. Principal, Edif. Empresarial, Caracas" HorizontalAlignment="Center" FontSize="9" />
                        <TextBlock Text="Telf: (0212) 555-1234 • contacto@deterpos.com" HorizontalAlignment="Center" FontSize="9" />

                        <Separator Margin="0,8" Background="#CCCCCC" Height="1" />

                        <!-- Título de Documento No Fiscal -->
                        <Border Background="#F3F4F6" Padding="4,3" Margin="0,0,0,4">
                            <TextBlock Text="PRESUPUESTO / COTIZACIÓN" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="*** DOCUMENTO NO FISCAL ***" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#666666" Margin="0,0,0,6" />

                        <!-- Datos del Presupuesto -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="N° COTIZACIÓN: " FontWeight="Bold" />
                            <TextBlock Grid.Column="1" x:Name="TxtQuotationNumber" Text="COT-00000001" HorizontalAlignment="Right" FontWeight="Bold" />
                        </Grid>

                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FECHA EMISIÓN: " />
                            <TextBlock Grid.Column="1" x:Name="TxtCreatedAt" Text="21/11/2026 12:00" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VÁLIDO HASTA: " FontWeight="Bold" />
                            <TextBlock Grid.Column="1" x:Name="TxtValidUntil" Text="28/11/2026" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#B45309" />
                        </Grid>

                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TASA REF. BCV: " />
                            <TextBlock Grid.Column="1" x:Name="TxtBcvRate" Text="1 USD = 55.4000 Bs." HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,6" Background="#CCCCCC" Height="1" />

                        <!-- Datos del Cliente -->
                        <TextBlock Text="CLIENTE SOLICITANTE:" FontWeight="Bold" />
                        <TextBlock x:Name="TxtCustomerName" Text="Cliente de Contado / Genérico" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtCustomerDoc" Text="CI/RIF: V-00000000" />
                        <TextBlock x:Name="TxtCustomerPhone" Text="Teléfono: -" />

                        <Separator Margin="0,6" Background="#CCCCCC" Height="1" />

                        <!-- Encabezado de Renglones -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CANT" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="DESCRIPCIÓN" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="P.UNIT($)" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="TOTAL($)" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Separator Margin="0,2,0,4" Background="#E0E0E0" Height="1" />

                        <!-- Renglones de la Cotización -->
                        <ItemsControl x:Name="ItemsDetails">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat='{}{0:G29}'}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextWrapping="Wrap" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding UnitPriceUSD, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalPriceUSD, StringFormat='{}{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8" Background="#CCCCCC" Height="1" />

                        <!-- Totales en USD -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SUBTOTAL:" />
                            <TextBlock Grid.Column="1" x:Name="TxtSubtotalUSD" Text="$ 0.00" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IVA ESTIMADO (16%):" />
                            <TextBlock Grid.Column="1" x:Name="TxtVatUSD" Text="$ 0.00" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,4" Background="#999999" Height="1" />

                        <!-- Total Final en USD y VES -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL USD:" FontWeight="Bold" FontSize="13" />
                            <TextBlock Grid.Column="1" x:Name="TxtTotalUSD" Text="$ 0.00" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL EN BOLÍVARES:" FontWeight="Bold" FontSize="12" />
                            <TextBlock Grid.Column="1" x:Name="TxtTotalVES" Text="0.00 Bs." FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,8" Background="#CCCCCC" Height="1" />

                        <!-- Notas y Condiciones Comerciales -->
                        <TextBlock Text="CONDICIONES COMERCIALES:" FontWeight="Bold" FontSize="9.5" />
                        <TextBlock x:Name="TxtNotes" Text="• Precios calculados a tasa oficial BCV del día de emisión." FontSize="9" TextWrapping="Wrap" />
                        <TextBlock Text="• La presente cotización no reserva mercancía en almacén." FontSize="9" TextWrapping="Wrap" />
                        <TextBlock Text="• Puede ser facturada en caja presentando este documento." FontSize="9" TextWrapping="Wrap" />

                        <Separator Margin="0,8" Background="#CCCCCC" Height="1" />
                        <TextBlock Text="¡Gracias por su preferencia!" HorizontalAlignment="Center" FontWeight="Bold" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Botones Inferiores -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="18,12" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="BtnPrint_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0" Padding="12,9" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fluentIcons:SymbolIcon Symbol="Print" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Imprimir Proforma" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="BtnClose_Click" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" Padding="12,9" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cerrar" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
