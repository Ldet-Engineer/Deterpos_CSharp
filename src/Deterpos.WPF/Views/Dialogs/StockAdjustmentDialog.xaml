<Window x:Class="Deterpos.WPF.Views.Dialogs.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Ajuste de Stock" 
        Height="480" Width="460"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#D0D7DE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado Modal -->
            <Border Grid.Row="0" Background="#F6F8FA" CornerRadius="12,12,0,0" Padding="20,16" BorderBrush="#E1E4E8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fluentIcons:SymbolIcon Grid.Column="0" Symbol="ArrowTrendingLines" FontSize="24" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Ajuste Físico de Stock" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TxtProductName" Text="Producto seleccionado" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnCancel_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Cuerpo del Formulario -->
            <Border Grid.Row="1" Padding="24,20">
                <StackPanel>

                    <!-- Stock Actual -->
                    <TextBlock Text="Stock Actual en Sistema:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <Border Background="#F9FAFB" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtCurrentStock" Text="0.00 Unidades" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <!-- Nuevo Stock Físico -->
                    <TextBlock Text="Nuevo Stock Físico Contado *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtNewStock" Text="0.00" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                    <!-- Motivo con ComboBox Moderno -->
                    <TextBlock Text="Motivo del Ajuste *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbReason" SelectedIndex="0" Margin="0,0,0,16">
                        <ComboBoxItem Content="Toma Física de Inventario (Auditoría)" />
                        <ComboBoxItem Content="Merma / Producto Roto o Dañado" />
                        <ComboBoxItem Content="Fecha de Vencimiento Expirada" />
                        <ComboBoxItem Content="Corrección de Conteo Inicial" />
                        <ComboBoxItem Content="Devolución de Muestra / Consumo Interno" />
                    </ComboBox>

                </StackPanel>
            </Border>

            <!-- Acciones -->
            <Border Grid.Row="2" Background="#F6F8FA" CornerRadius="0,0,12,12" Padding="20,14" BorderBrush="#E1E4E8" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="BtnCancel_Click" Content="Cancelar" Background="Transparent" BorderBrush="#D0D7DE" BorderThickness="1"
                            Padding="16,8" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Click="BtnApply_Click" Content="Aplicar Ajuste" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                            Padding="20,8" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>

