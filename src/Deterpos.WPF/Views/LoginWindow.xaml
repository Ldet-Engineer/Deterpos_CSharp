<Window x:Class="Deterpos.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Deterpos ERP - Iniciar Sesión"
        Icon="pack://application:,,,/Resources/favicon.ico"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="25" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000" />
    </Window.Resources>

    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="12" Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR / DRAGGABLE -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/favicon-32x32.png" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DETERPOS ERP" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" • ENTERPRISE" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                        <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- CUERPO PRINCIPAL DEL LOGIN -->
            <StackPanel Grid.Row="1" Margin="32,24,32,16" VerticalAlignment="Center">
                <!-- Logo Oficial Deterpos y Título Central -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,14" Padding="6">
                    <Image Source="pack://application:,,,/Resources/android-chrome-192x192.png" Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <TextBlock Text="Control de Acceso Seguro" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Autenticación de cajero y personal autorizado" FontSize="12.5" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

                <!-- Campo Usuario -->
                <TextBlock Text="Nombre de Usuario / Identificador:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="{StaticResource TextPrimaryBrush}" />
                <Grid Margin="0,0,0,14">
                    <TextBox x:Name="TxtUsername" Padding="32,8,10,8" FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center" KeyDown="TxtUsername_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <fluentIcons:SymbolIcon Symbol="Person" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña del Sistema:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="{StaticResource TextPrimaryBrush}" />
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="TxtPassword" Padding="32,8,10,8" FontSize="13" VerticalContentAlignment="Center" KeyDown="TxtPassword_KeyDown" PasswordChanged="TxtPassword_PasswordChanged">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>
                    <fluentIcons:SymbolIcon Symbol="Key" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Alerta de Bloq Mayús -->
                <StackPanel x:Name="PnlCapsLockWarning" Orientation="Horizontal" Margin="0,2,0,8" Visibility="Collapsed">
                    <fluentIcons:SymbolIcon Symbol="Warning" FontSize="13" Foreground="#B45309" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Bloq Mayús está activado" FontSize="11" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Mensaje de Error -->
                <Border x:Name="BrdError" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <fluentIcons:SymbolIcon Symbol="DismissCircle" FontSize="16" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtError" Text="Credenciales inválidas" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Botón Iniciar Sesión -->
                <Button x:Name="BtnLogin" Click="BtnLogin_Click" IsDefault="True" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                        Padding="0,11" FontSize="13.5" FontWeight="Bold" Cursor="Hand" Margin="0,10,0,8">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="ArrowEnter" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ingresar al Sistema" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- PIE DE VENTANA: INFORMACIÓN DEL SISTEMA -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Seguridad PBKDF2-SHA256 • PostgreSQL 16" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="v2.0 LTS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>