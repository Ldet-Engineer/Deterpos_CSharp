<UserControl x:Class="Deterpos.WPF.Views.CurrencyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24" MaxWidth="1350" HorizontalAlignment="Stretch">

            <!-- Encabezado de la Vista -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gestión Multimoneda y Tasas de Cambio" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Configuración de paridades, monedas activas e histórico de auditoría cambiaria" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Click="BtnOpenCalculator_Click" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            Padding="16,8" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Calculator" FontSize="18" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Calculadora de Divisas" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="BtnOpenUpdateRate_Click" Background="{StaticResource PrimaryBrandBrush}" Foreground="White" BorderThickness="0"
                            Padding="18,8" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <fluentIcons:SymbolIcon Symbol="Money" FontSize="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Actualizar Tasa del Día" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tarjetas de Monedas Principales -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- USD -->
                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DÓLAR AMERICANO (USD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border Background="#E5F1FB" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="Base Fija" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="$ 1.0000" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="Anclaje de costos y precios" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- VES -->
                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="BOLÍVAR DIGITAL (VES)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border Background="#E6F4EA" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="Oficial BCV" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtCardVes" Text="55.4000 Bs." FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="Moneda legal Venezuela" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- EUR -->
                <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="EURO (EUR)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border Background="#F0F0F0" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="Opcional" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtCardEur" Text="1.0800 €" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="Paridad internacional" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- COP -->
                <Border Grid.Column="6" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="PESO COLOMBIANO (COP)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border Background="#F0F0F0" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="Opcional" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtCardCop" Text="4250.00 Col$" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="Comercio fronterizo" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Grilla de Histórico de Tasas de Cambio -->
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Histórico de Variaciones Cambiarias" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Registro cronológico inalterable con trazabilidad y fuente para auditoría fiscal" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Click="BtnRefreshHistory_Click" HorizontalAlignment="Right" Background="Transparent" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <fluentIcons:SymbolIcon Symbol="ArrowCounterclockwise" FontSize="16" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refrescar Historial" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="DgHistory" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E4E8" Background="White"
                              RowHeight="38" FontSize="13" BorderThickness="1" BorderBrush="#E1E4E8" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha y Hora (UTC)" Binding="{Binding EffectiveDate, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="180" />
                            <DataGridTextColumn Header="Moneda" Binding="{Binding CurrencyCode}" Width="100" />
                            <DataGridTextColumn Header="Tasa a 1 USD" Binding="{Binding RateToUSD, StringFormat={}{0:N4}}" Width="140" />
                            <DataGridTextColumn Header="Fuente Oficial" Binding="{Binding Source}" Width="160" />
                            <DataGridTextColumn Header="Registrado Por" Binding="{Binding RegisteredBy}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

